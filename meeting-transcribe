DEFAULT_ASR = "http://127.0.0.1:8731"  # Lemonade: OpenAI-compatible verbose_json
DEFAULT_ASR_MODEL = "Whisper-Large-v3-Turbo"
DEFAULT_DIARIZER = "nemotron"
SHERPA_IMAGE = "localhost/halogen-diarizer:latest"
PYANNOTE_IMAGE = "localhost/halogen-diarizer-pyannote-rocm:latest"
NEMOTRON_IMAGE = "localhost/halogen-diarizer-nemotron:latest"
# Measured, not guessed: gufo caps the transcript of every audio chunk at
# `max_tokens` (512 maximum, 256 by default) whatever room the context has, and
# a 150 s clip already emits 485 of the 512. At 180 s it sits exactly on the cap
# and from there the tail is dropped silently: a 240 s clip of dense speech lost
# 170 words. So a request holds one server chunk, cut earlier only when a turn
# is longer than this.
MAX_SEGMENT_S = 150.0
MAX_TOKENS = 512
# Cut points come from the diarizer, whose edges are off by a fraction of a
# second: grow each turn into the silence beside it so no word loses a phone.
TURN_PAD_S = 0.3
# Shorter than any word, so the ASR can only invent text for such a clip.
MIN_CLIP_S = 0.2
# Two uploads of the same room (a microphone that also hears the loudspeakers)
# are one conversation recorded twice. When this much of the shorter track's
# speech is covered by the other, the second track is deduplicated instead of
# unioned, so the same words do not come out as two different speakers.
REDUNDANT_SHARE = 0.6
# How much of a second-track turn the first track must already cover for it to
# be the same wall-clock audio rather than a second voice.
COVERED_SHARE = 0.5
DUPLICATE_WINDOW_S = 1.5
ATTEMPTS = 3
RETRY_S = 1.0
RETRYABLE = (408, 409, 429, 500, 502, 503, 504)


_REMOTE: bool | None = None


def podman_is_remote() -> bool:
    """True when podman talks to a socket instead of running here.

    `--group-add keep-groups` is the only way to keep /dev/kfd usable inside a
    rootless diarizer, and a remote podman rejects it; there the device nodes are
    world-readable (0666) anyway, so the flag is not needed.
    """
    global _REMOTE
    if _REMOTE is None:
        try:
            result = subprocess.run(
                ["podman", "info", "--format", "{{.Host.ServiceIsRemote}}"],
                capture_output=True, text=True, timeout=15)
            _REMOTE = result.stdout.strip() == "true"
        except (OSError, subprocess.SubprocessError):
            _REMOTE = False
    return _REMOTE


def diarizer_command(backend: str, source: Path, workdir: Path, speakers: int,
                     threshold: float, min_speakers: int = -1,
                     max_speakers: int = -1) -> list[str]:
    """The podman command for one diarization run.

    sherpa is CPU and networkless. pyannote-rocm needs the GPU devices, the HF
    cache mounted read-write and its token, and reaches the Hub once to fetch
    the gated models (after that the cache is enough).

    Only pyannote estimates the speaker count, so it is the only backend that
    takes a range: sherpa's clustering wants an exact number or a threshold.
    """
    command = [
        "podman", "run", "--rm", "--security-opt", "no-new-privileges",
        "-v", f"{source}:/in:ro", "-v", f"{workdir}:/out:rw",
    ]
    tail = ["/in", "--out", "/out", "--speakers", str(speakers)]
    if backend == "sherpa":
        return command + ["--network=none", SHERPA_IMAGE] + tail + ["--threshold", str(threshold)]
    if backend == "pyannote-rocm":
        if min_speakers > 0:
            tail += ["--min-speakers", str(min_speakers)]
        if max_speakers > 0:
            tail += ["--max-speakers", str(max_speakers)]
        cache = Path.home() / ".cache/huggingface"
        command += ["--device", "/dev/kfd", "--device", "/dev/dri",
                    "--security-opt", "seccomp=unconfined",
                    "--ipc=host", "-v", f"{cache}:/hf:rw",
                    "-e", "HF_HOME=/hf", "-e", "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1"]
        if not podman_is_remote():
            command += ["--group-add", "keep-groups"]
        token = os.environ.get("HF_TOKEN") or (
            (cache / "token").read_text().strip() if (cache / "token").is_file() else "")
        if token:
            command += ["-e", f"HF_TOKEN={token}"]
        return command + [PYANNOTE_IMAGE] + tail
    if backend == "nemotron":
        # Nemotron reads the whole file and normalizes it itself (ffmpeg +
        # loudnorm), exactly like the pyannote image, so the caller still finds
        # workdir/audio.wav. It needs the GPU devices but no HF token: the
        # checkpoint is public, the cache is mounted only to avoid re-downloads.
        cache = Path.home() / ".cache/huggingface"
        command += ["--device", "/dev/kfd", "--device", "/dev/dri",
                    "--security-opt", "seccomp=unconfined",
                    "--ipc=host", "-v", f"{cache}:/hf:rw",
                    "-e", "HF_HOME=/hf", "-e", "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1"]
        if not podman_is_remote():
            command += ["--group-add", "keep-groups"]
        return command + [NEMOTRON_IMAGE] + tail
    raise SystemExit(f"unknown diarizer: {backend}")


def diarize(backend: str, source: Path, workdir: Path, speakers: int, threshold: float,
            timeout: float, min_speakers: int = -1, max_speakers: int = -1) -> list[dict]:
    """Run the diarizer container on source; return its JSON segments.

    The container writes the normalized 16 kHz mono WAV into workdir, which the
    caller then cuts with the stdlib.
    """
    command = diarizer_command(backend, source, workdir, speakers, threshold,
                               min_speakers, max_speakers)
    result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()[-500:]
        raise SystemExit(f"diarizer failed ({result.returncode}): {detail}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise SystemExit(f"diarizer printed no JSON segments: {error}\n{result.stdout[:300]}")


def build_turns(segments: list[dict], gap: float) -> list[dict]:
    """Merge adjacent same-speaker segments separated by at most `gap` seconds."""
    turns: list[dict] = []
    for segment in sorted(segments, key=lambda s: (s["start"], s["end"])):
        if turns and turns[-1]["speaker"] == segment["speaker"] \
                and segment["start"] - turns[-1]["end"] <= gap:
            turns[-1]["end"] = max(turns[-1]["end"], segment["end"])
        else:
            turns.append({"speaker": segment["speaker"],
                          "start": float(segment["start"]), "end": float(segment["end"])})
    return turns


def pad_turns(turns: list[dict], pad: float) -> list[dict]:
    """Grow every turn into the silence around it, by at most `pad` seconds.

    At most half of each gap, so two neighbouring turns can never overlap and a
    turn never picks up the next speaker's words: only silence is added.
    """
    padded = []
    for index, turn in enumerate(turns):
        # Diarizer segments of different speakers may overlap (crosstalk): a
        # negative pad would shrink a turn past its own start.
        left = pad if index == 0 else max(
            0.0, min(pad, (turn["start"] - turns[index - 1]["end"]) / 2))
        right = pad if index + 1 == len(turns) else max(
            0.0, min(pad, (turns[index + 1]["start"] - turn["end"]) / 2))
        padded.append(dict(turn,
                           start=round(max(0.0, turn["start"] - left), 3),
                           end=round(turn["end"] + right, 3)))
    return padded


def parse_names(spec: str | None) -> dict[int, str]:
    """Parse --names "1:Anna,2:Bernd" into {1: "Anna", 2: "Bernd"}."""
    names: dict[int, str] = {}
    for item in (spec or "").replace(";", ",").split(","):
        if not item.strip():
            continue
        number, _, name = item.partition(":")
        if not number.strip().isdigit() or not name.strip():
            raise SystemExit(f'--names wants "1:Anna,2:Bernd", got {item!r}')
        names[int(number)] = name.strip()
    return names


def number_speakers(turns: list[dict]) -> list[dict]:
    """Relabel speakers 1..N in order of first appearance.

    sherpa-onnx returns its own cluster ids (0-based with several speakers,
    but a lone cluster can come back as 1), so the raw id is not a speaker
    number.
    """
    order: dict = {}
    for turn in turns:
        order.setdefault(turn["speaker"], len(order) + 1)
    return [dict(turn, speaker=order[turn["speaker"]]) for turn in turns]


def load_diarization(path: Path) -> list[dict]:
    """Read an external diarization: a list of segments, or a dict with one.

    pyannote runs in this house print `{"diarization": [{start, end, speaker}]}`;
    a bare list and this repo's `turns` are accepted too.
    """
    data = json.loads(path.read_text(encoding="utf-8"))
    if isinstance(data, dict):
        data = data.get("diarization") or data.get("turns") or data.get("segments") or []
    return [{"start": float(seg["start"]), "end": float(seg["end"]),
             "speaker": seg["speaker"]} for seg in data]


def relabel_turns(turns: list[dict], segments: list[dict]) -> list[dict]:
    """Give every turn the external speaker it overlaps most, numbered 1..N.

    For a reference diarization the two tracks' own labels are guesses; this
    replaces them. A turn in a reference gap inherits the previous speaker.
    """
    if not segments:
        return turns
    labelled = []
    previous = segments[0]["speaker"]
    for turn in sorted(turns, key=lambda t: (t["start"], t["end"])):
        weight: dict = {}
        for segment in segments:
            overlap = min(turn["end"], segment["end"]) - max(turn["start"], segment["start"])
            if overlap > 0:
                weight[segment["speaker"]] = weight.get(segment["speaker"], 0.0) + overlap
        previous = max(weight, key=weight.get) if weight else previous
        labelled.append(dict(turn, speaker=previous, name=None))
    return number_speakers(labelled)


def split_turn(turn: dict, index: int, max_s: float) -> list[dict]:
    """Cut a turn into <= max_s chunks, each tagged with its turn index."""
    chunks = []
    start = turn["start"]
    while turn["end"] - start > max_s:
        chunks.append({"turn": index, "speaker": turn["speaker"],
                       "start": round(start, 3), "end": round(start + max_s, 3)})
        start += max_s
    chunks.append({"turn": index, "speaker": turn["speaker"],
                   "start": round(start, 3), "end": round(turn["end"], 3)})
    return chunks


def wav_seconds(path: Path) -> float | None:
    """Length of a WAV file in seconds, or None when it cannot be read."""
    try:
        with wave.open(str(path), "rb") as wav:
            return round(wav.getnframes() / (wav.getframerate() or 1), 1)
    except (wave.Error, EOFError, OSError):
        return None


def slice_wav(path: Path, start: float, end: float) -> bytes:
    """Return the [start, end) seconds of a 16-bit mono WAV as a WAV bytestring."""
    with wave.open(str(path), "rb") as wav:
        rate = wav.getframerate()
        total = wav.getnframes()
        params = wav.getparams()
        first = max(0, min(int(start * rate), total))
        last = max(first, min(int(end * rate), total))
        wav.setpos(first)
        frames = wav.readframes(last - first)
    buffer = io.BytesIO()
    with wave.open(buffer, "wb") as clip:
        clip.setparams(params)
        clip.writeframes(frames)
    return buffer.getvalue()


def multipart(fields: dict | list[tuple[str, str]], filename: str, data: bytes) -> tuple[bytes, str]:
    """A multipart/form-data body with text fields and one file part."""
    boundary = "----halogen" + uuid.uuid4().hex
    body = bytearray()
    items = fields.items() if isinstance(fields, dict) else fields
    for name, value in items:
        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode()
    body += (f"--{boundary}\r\n"
             f"Content-Disposition: form-data; name=\"file\"; filename=\"{filename}\"\r\n"
             f"Content-Type: audio/wav\r\n\r\n").encode()
    body += data + f"\r\n--{boundary}--\r\n".encode()
    return bytes(body), boundary


def _words(text: str) -> list[str]:
    return [word for word in (re.sub(r"[^\w]+", "", part).lower() for part in text.split()) if word]


def is_prompt_echo(text: str, prompt: str, prefix: int = 12, overlap: float = 0.85) -> bool:
    """True when a transcription is the hotwords prompt read back, not speech.

    On silence or overlapping speech the model sometimes emits the prompt
    verbatim (or its first part). A clip whose opening words are the prompt's
    opening words, or whose words almost all come from the prompt, is that echo.
    """
    text_words = _words(text)
    prompt_words = _words(prompt)
    if len(text_words) < prefix or len(prompt_words) < prefix:
        return False
    if text_words[:prefix] == prompt_words[:prefix]:
        return True
    prompt_set = set(prompt_words)
    contained = sum(1 for word in text_words if word in prompt_set) / len(text_words)
    return contained >= overlap


def is_degenerate(text: str, floor: int = 4, share: float = 0.7) -> bool:
    """True when a transcription is one phrase repeated to fill the clip.

    On music, noise and overlap the model loops ("danke danke danke"). A real
    "nein, nein, nein" survives: the repeat has to be most of the clip.

    shortcut: only a repeated 1-3 word phrase; widen the window if a transcript
    shows a longer loop.
    """
    words = _words(text)
    if len(words) < floor:
        return False
    for size in (1, 2, 3):
        counts = Counter(tuple(words[start:start + size])
                         for start in range(len(words) - size + 1))
        count = counts.most_common(1)[0][1]
        if count >= floor and count * size / len(words) >= share:
            return True
    return False


def rejoin(words: list[dict]) -> str:
    """Rebuild a segment's text from its words.

    The endpoint's own `text` is broken two ways: the server wraps lines at 32
    characters and Lemonade turns that wrap into a space, so "Insel" arrives as
    "In sel". `words[]` keeps the truth: a piece that does not start with a space
    continues the previous one, so a plain concatenation restores the word.
    """
    return "".join(str(word.get("word", "")) for word in words)


def starts_mid_word(words: list[dict]) -> bool:
    """True when a segment opens in the middle of the previous segment's word."""
    return bool(words) and not str(words[0].get("word", "")).startswith(" ")


def unwrap(text: str) -> str:
    """Normalise the ASR server's fixed-width line wrap into single spaces.

    The whisper server breaks lines every 32 characters. When the break falls
    inside a word the fix is rejoin() on words[], which knows which piece
    continues which; here we only collapse whitespace, so a text that arrives
    without words[] stays readable ("In\\nsel" -> "In sel") instead of gluing
    two unrelated words together.
    """
    return re.sub(r"\s+", " ", text.replace("\n", " ")).strip()


def transcribe(url: str, clip: bytes, model: str, language: str | None,
               prompt: str | None, timeout: float, attempts: int = ATTEMPTS,
               max_tokens: int = MAX_TOKENS) -> str:
    fields = {"model": model, "response_format": "json"}
    if language:
        fields["language"] = language
    if prompt:
        fields["prompt"] = prompt
    if max_tokens > 0:
        # Without this the endpoint keeps its own smaller cap and drops the tail.
        fields["max_tokens"] = str(max_tokens)
    body, boundary = multipart(fields, "segment.wav", clip)
    # A long meeting sends hundreds of clips: one admission-queue 429 or a
    # restarting endpoint must cost a retry, not the whole job.
    for attempt in range(1, attempts + 1):
        request = urllib.request.Request(
            url, data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                text = str(json.loads(response.read()).get("text", "")).strip()
            break
        except urllib.error.HTTPError as error:
            with error:
                detail = error.read().decode(errors="replace")[:300]
            failure = f"ASR refused a {len(clip)} byte clip: {error.code} {detail}"
            if error.code not in RETRYABLE:
                raise SystemExit(failure)
        except (urllib.error.URLError, TimeoutError) as error:
            failure = f"ASR unreachable: {error}"
        if attempt == attempts:
            raise SystemExit(f"{failure} (after {attempts} tries)")
        time.sleep(RETRY_S * attempt)
    # The model echoes the hotword prompt on silence/overlap: drop it, it is not speech.
    if prompt and is_prompt_echo(text, prompt):
        return ""
    if is_degenerate(text):
        return ""
    return unwrap(text)


TIMESTAMP = re.compile(r"\[(\d+(?:\.\d+)?)\]")
SPEAKER = re.compile(r"\[S(\d+)\]")


def parse_diarized(text: str) -> list[dict]:
    """Split audio.cpp's answer into turns.

    It answers one line: "[0.26][S01] words[end][start][S02] words[end]", where
    every segment after the first is preceded by the previous end and its own
    start, and the last one ends with a lone end.
    """
    chunks = SPEAKER.split(text)
    lead = TIMESTAMP.findall(chunks[0])
    start = float(lead[-1]) if lead else 0.0
    turns = []
    for index in range(1, len(chunks) - 1, 2):
        speaker, body = int(chunks[index]), chunks[index + 1]
        times = TIMESTAMP.findall(body)
        spoken = TIMESTAMP.split(body)[0].strip()
        end = float(times[0]) if times else start
        if spoken:
            turns.append({"speaker": speaker, "start": round(start, 2),
                          "end": round(max(end, start), 2), "text": spoken})
        start = float(times[1]) if len(times) > 1 else end
    return turns


def normalize_wav(source: Path, out: Path) -> None:
    """16 kHz mono s16le, which is all audio.cpp accepts without SOXR."""
    out.parent.mkdir(parents=True, exist_ok=True)
    result = subprocess.run(
        ["ffmpeg", "-nostdin", "-y", "-v", "error", "-i", str(source),
         "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", str(out)],
        capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(f"ffmpeg could not convert {source}: {result.stderr.strip()[:300]}")


AUDIOCPP_MODELS = {
    "moss-transcribe-diarize": {
        "id": "moss-transcribe-diarize",
        "family": "moss_transcribe_diarize",
        "path": "/opt/audiocpp/models/MOSS-Transcribe-Diarize-GGUF/moss-transcribe-diarize-bf16.gguf",
        "task": "asr",
        "mode": "offline",
    },
}


def load_audiocpp_model(transcription_url: str, model: str) -> bool:
    """Load an audio.cpp model on demand when the server unloaded it."""
    spec = AUDIOCPP_MODELS.get(model)
    if not spec:
        return False
    base = transcription_url.split("/v1/")[0]
    request = urllib.request.Request(
        f"{base}/v1/models/load", data=json.dumps(spec).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            return 200 <= getattr(response, "status", 200) < 300
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def transcribe_diarized(url: str, audio: Path, model: str, timeout: float,
                        max_tokens: int, attempts: int = ATTEMPTS) -> str:
    """audio.cpp transcribes a file it opens itself, and labels the speakers.

    The clip travels as a path, not as an upload, so the file has to sit where
    the ASR server can read it (--asr-dir).

    `max_tokens` is not a nicety here: MOSS stops with "reached max_tokens before
    EOS" when the meeting runs past its default cap (5120), and the answer is
    lost. It has to travel under "options": at the top level the server ignores
    it without a word, which is exactly how a long meeting comes back empty.
    """
    body = json.dumps({"model": model, "audio": str(audio),
                       "options": {"max_tokens": max_tokens}}).encode()
    failure = "ASR unreachable"
    for attempt in range(1, attempts + 1):
        request = urllib.request.Request(
            url, data=body, headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                answer = json.loads(response.read())
            return str(answer.get("text") or "")
        except urllib.error.HTTPError as error:
            with error:
                detail = error.read().decode(errors="replace")[:300]
            failure = f"ASR refused the file: {error.code} {detail}"
            if error.code == 404 and load_audiocpp_model(url, model):
                continue
            if error.code not in RETRYABLE:
                raise SystemExit(failure)
        except (urllib.error.URLError, TimeoutError) as error:
            failure = f"ASR unreachable: {error}"
        if attempt == attempts:
            raise SystemExit(f"{failure} (after {attempts} tries)")
        time.sleep(RETRY_S * attempt)
    raise SystemExit(failure)


# MOSS spends ~795 tokens of prompt a minute, and the cap has to be generous:
# on a 38-minute meeting 24000 output tokens still end in "reached max_tokens
# before EOS", while the UI's own run of the same meeting finished with 65536
# (decode cache 99900 steps). A tight cap does not truncate the transcript, it
# loses it.
AUDIOCPP_MAX_TOKENS = 65536
MISTRAL_URL = "https://api.mistral.ai"
# Mistral's /v1/audio/transcriptions has a 65,536-token context window (~34 min).
MISTRAL_MAX_S = 1500.0
ISO_LANGS = {"german": "de", "italian": "it", "english": "en", "french": "fr",
             "spanish": "es", "portuguese": "pt", "dutch": "nl", "polish": "pl",
             "russian": "ru", "turkish": "tr", "swedish": "sv", "japanese": "ja",
             "chinese": "zh", "arabic": "ar"}


def iso_language(language: str | None) -> str:
    """Two-letter ISO 639-1 code for endpoints that reject 'auto' or full names."""
    raw = (language or "").strip().lower()
    if not raw or raw == "auto":
        return ""
    if len(raw) == 2 and raw.isalpha():
        return raw
    return ISO_LANGS.get(raw, "")


def is_mistral_asr(model: str, mode: str = "") -> bool:
    name = (model or "").removeprefix("mistral.")
    return mode == "mistral" or name.startswith("voxtral-")


def transcribe_mistral(url: str, audio: Path, model: str, language: str | None,
                       hotwords: str, key: str, timeout: float,
                       attempts: int = ATTEMPTS) -> list[dict]:
    """One request to Mistral's /v1/audio/transcriptions with speaker diarization."""
    if not key:
        raise SystemExit("MISTRAL_API_KEY is required for Mistral transcription models")
    clean_model = model.removeprefix("mistral.")
    # If someone picked the realtime model id for a batch job, use the offline one.
    if "realtime" in clean_model:
        clean_model = "voxtral-mini-transcribe-3"
    fields: list[tuple[str, str]] = [
        ("model", clean_model),
        ("diarize", "true"),
        ("timestamp_granularities", "segment"),
    ]
    lang = iso_language(language)
    if lang:
        fields.append(("language", lang))
    for term in (part.strip() for part in (hotwords or "").split(",")):
        if term:
            fields.append(("context_bias", term))
    body, boundary = multipart(fields, audio.name, audio.read_bytes())
    headers = {
        "Authorization": f"Bearer {key}",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "User-Agent": "meeting-stack/1.0",
    }
    failure = "Mistral ASR unreachable"
    for attempt in range(1, attempts + 1):
        request = urllib.request.Request(url, data=body, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.loads(response.read())
            turns = []
            for seg in payload.get("segments") or []:
                spoken = unwrap(str(seg.get("text") or ""))
                if not spoken:
                    continue
                start = float(seg.get("start") or 0.0)
                end = max(float(seg.get("end") or start), start)
                speaker = str(seg.get("speaker_id") or "speaker_1")
                turns.append({"speaker": speaker, "start": round(start, 2),
                              "end": round(end, 2), "text": spoken})
            if not turns and payload.get("text"):
                spoken = unwrap(str(payload["text"]))
                if spoken:
                    turns.append({"speaker": "speaker_1", "start": 0.0,
                                  "end": round(wav_seconds(audio) or 0.0, 2), "text": spoken})
            return turns
        except urllib.error.HTTPError as error:
            with error:
                detail = error.read().decode(errors="replace")[:300]
            failure = f"Mistral ASR refused the file: {error.code} {detail}"
            if error.code not in RETRYABLE:
                raise SystemExit(failure)
        except (urllib.error.URLError, TimeoutError) as error:
            failure = f"Mistral ASR unreachable: {error}"
        if attempt == attempts:
            raise SystemExit(f"{failure} (after {attempts} tries)")
        time.sleep(RETRY_S * attempt)
    raise SystemExit(failure)


def mistral_turns(args, source: Path, workdir: Path, hotwords: str,
                  lenient: bool) -> list[dict]:
    """Normalize to 16 kHz mono WAV and diarize+transcribe via Mistral."""
    audio = workdir / "audio.wav"
    normalize_wav(source, audio)
    base = getattr(args, "mistral_url", MISTRAL_URL).rstrip("/")
    url = f"{base}/v1/audio/transcriptions"
    key = getattr(args, "mistral_key", "") or os.environ.get("MISTRAL_API_KEY", "")
    seconds = wav_seconds(audio) or 0.0
    wait = max(args.asr_timeout, seconds * 0.5 + 120)
    if seconds <= MISTRAL_MAX_S:
        turns = transcribe_mistral(url, audio, args.model, args.language, hotwords, key, wait)
    else:
        turns = []
        chunk_path = workdir / "chunk.wav"
        offset = 0.0
        while offset < seconds:
            chunk_path.write_bytes(
                slice_wav(audio, offset, min(offset + MISTRAL_MAX_S, seconds)))
            for turn in transcribe_mistral(url, chunk_path, args.model,
                                           args.language, hotwords, key, wait):
                turns.append(dict(turn, start=round(turn["start"] + offset, 2),
                                  end=round(turn["end"] + offset, 2)))
            offset += MISTRAL_MAX_S
    if not turns:
        if lenient:
            return []
        raise SystemExit("ASR returned no turns")
    print(f"asr: {len(turns)} diarized segments from Mistral ({args.model})", file=sys.stderr)
    # Mistral hands out speaker_1, speaker_2, ... per request; number_speakers()
    # downstream relabels them 1..N in order of first appearance, which is what
    # the rest of the pipeline expects.
    return number_speakers(turns)


def audiocpp_turns(args, source: Path, workdir: Path, lenient: bool) -> list[dict]:
    """One request to audio.cpp, which returns the speakers itself.

    No diarizer and no clip cutting: the model hands back "[start][Sxx] words"
    with the turns already separated, so nothing can be truncated and nobody has
    to guess where one voice stops.
    """
    name = f"meeting-{uuid.uuid4().hex[:12]}.wav"
    shared = Path(args.asr_dir) / name
    normalize_wav(source, shared)
    remote = Path(args.asr_remote_dir or args.asr_dir) / name
    seconds = wav_seconds(shared) or 0.0
    cap = max(args.max_tokens, AUDIOCPP_MAX_TOKENS)
    # One request for the whole file means one silence as long as the meeting:
    # the answer arrives when the model is done, not a word at a time. A
    # 38-minute meeting measured 25 minutes of wall time, so 0.6x would have cut
    # it off just before the end.
    wait = max(args.asr_timeout, seconds * 1.2 + 600)
    try:
        text = transcribe_diarized(args.asr.rstrip("/") + "/v1/audio/transcriptions",
                                   remote, args.model, wait, cap)
    finally:
        # The duration is read back from the normalized WAV, so it moves into
        # this track's workdir instead of staying in the shared directory.
        if shared.exists():
            shutil.move(str(shared), str(workdir / "audio.wav"))
    turns = parse_diarized(text)
    if not turns:
        if lenient:
            return []
        raise SystemExit("ASR returned no turns")
    print(f"asr: {len(turns)} turns in one request", file=sys.stderr)
    return turns


def transcribe_full(url: str, audio: Path, model: str, language: str | None,
                    prompt: str | None, timeout: float,
                    attempts: int = ATTEMPTS) -> list[dict]:
    """One ASR request for the whole file; returns segments with timestamps.

    The endpoint must be OpenAI-compatible and answer verbose_json (whisper via
    Lemonade, not gufo). No max_tokens is sent: capping the output of a whole
    meeting is how a tail disappears silently.
    """
    fields = {"model": model, "response_format": "verbose_json"}
    if language:
        fields["language"] = language
    if prompt:
        fields["prompt"] = prompt
    body, boundary = multipart(fields, audio.name, audio.read_bytes())
    failure = "ASR unreachable"
    for attempt in range(1, attempts + 1):
        request = urllib.request.Request(
            url, data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.loads(response.read())
            segments = []
            for seg in payload.get("segments", []):
                words = seg.get("words") or []
                text = rejoin(words) if words else str(seg.get("text", ""))
                segments.append({"start": float(seg["start"]), "end": float(seg["end"]),
                                 "text": unwrap(text), "joins": starts_mid_word(words)})
            return segments
        except urllib.error.HTTPError as error:
            with error:
                detail = error.read().decode(errors="replace")[:300]
            failure = f"ASR refused the full file: {error.code} {detail}"
            if error.code not in RETRYABLE:
                raise SystemExit(failure)
        except (urllib.error.URLError, TimeoutError) as error:
            failure = f"ASR unreachable: {error}"
        if attempt == attempts:
            raise SystemExit(f"{failure} (after {attempts} tries)")
        time.sleep(RETRY_S * attempt)
    raise SystemExit(failure)


REPEAT_RUN = 4          # identical ASR segments in a row before it looks like a loop
REPEAT_SPAN_S = 8.0     # ... covering this much audio
REPEAT_WORDS = 4        # ... of a sentence at least this long


def bare(text: str) -> str:
    """A comparison key: case and punctuation do not make two lines different."""
    return re.sub(r"[^\wäöüß ]", " ", text.lower()).strip()


def collapse_repetitions(segments: list[dict]) -> list[dict]:
    """Drop Whisper's repetition loop.

    On audio it cannot decode (music, crosstalk, a phone held to a speaker)
    Whisper latches onto one sentence and emits it again every second for
    minutes, with confident logprobs, so no server-side threshold catches it --
    the endpoint ignores `condition_on_previous_text`, `vad_filter` and
    `no_speech_threshold`. What gives the loop away is that a speaker cannot
    repeat the same five-word sentence four times in eight seconds, while
    repeating "ja" or "tschüss" that fast is normal. Only runs that clear all
    three bars are dropped; everything else is left exactly as the ASR said it.
    """
    kept: list[dict] = []
    index = 0
    while index < len(segments):
        end = index
        key = bare(segments[index]["text"])
        while end + 1 < len(segments) and bare(segments[end + 1]["text"]) == key:
            end += 1
        covered = segments[end]["end"] - segments[index]["start"]
        looping = (end - index + 1 >= REPEAT_RUN and covered >= REPEAT_SPAN_S
                   and len(key.split()) >= REPEAT_WORDS)
        if not looping:
            kept.extend(segments[index:end + 1])
        index = end + 1
    return kept


def fuse_segments(asr_segments: list[dict], diar_segments: list[dict]) -> list[dict]:
    """Give every ASR segment the speaker with the largest overlap with it.

    The ASR owns the words and the diarizer only labels them, so a diarizer edge
    off by half a second moves a word instead of losing audio. A segment that
    falls in a diarizer gap (silence it did not label) inherits the previous
    speaker, so no text is lost and no bogus speaker number appears.
    """
    labeled: list[dict] = []
    for segment in asr_segments:
        weight: dict = {}
        for diar in diar_segments:
            overlap = min(segment["end"], diar["end"]) - max(segment["start"], diar["start"])
            if overlap > 0:
                weight[diar["speaker"]] = weight.get(diar["speaker"], 0.0) + overlap
        speaker = max(weight, key=weight.get) if weight else None
        if speaker is None:
            if labeled:
                speaker = labeled[-1]["speaker"]
            elif diar_segments:
                speaker = min(diar_segments,
                              key=lambda d: abs(d["start"] - segment["start"]))["speaker"]
            else:
                speaker = 0
        labeled.append({"speaker": speaker, "start": segment["start"],
                        "end": segment["end"], "text": segment["text"],
                        "joins": segment.get("joins", False)})
    return labeled


def build_turns_labeled(segments: list[dict], gap: float) -> list[dict]:
    """Merge adjacent same-speaker ASR segments, joining their text."""
    turns: list[dict] = []
    for segment in sorted(segments, key=lambda s: (s["start"], s["end"])):
        if turns and turns[-1]["speaker"] == segment["speaker"] \
                and segment["start"] - turns[-1]["end"] <= gap:
            turns[-1]["end"] = max(turns[-1]["end"], segment["end"])
            glue = "" if segment.get("joins") else " "
            turns[-1]["text"] = f"{turns[-1]['text']}{glue}{segment['text']}".strip()
        else:
            turns.append({"speaker": segment["speaker"],
                          "start": float(segment["start"]), "end": float(segment["end"]),
                          "text": segment["text"]})
    return turns


def run_parallel(chunks: list[dict], work, parallel: int, progress=None) -> dict[int, str]:
    """Transcribe chunks up to `parallel` at a time; return {position: text}.

    The first failure cancels whatever has not started and re-raises, so a dead
    endpoint does not keep the whole meeting going.
    """
    results: dict[int, str] = {}
    with ThreadPoolExecutor(max_workers=max(1, parallel)) as pool:
        futures = {pool.submit(work, chunk): (position, chunk)
                   for position, chunk in enumerate(chunks, 1)}
        done = 0
        for future in as_completed(futures):
            position, chunk = futures[future]
            try:
                text = future.result()
            except BaseException:
                for pending in futures:
                    pending.cancel()
                raise
            results[position] = text
            done += 1
            if progress:
                progress(done, chunk, text)
    return results


def ordered_texts(chunks: list[dict], results: dict[int, str]) -> dict[int, list[str]]:
    """Group the per-position transcriptions by turn, in audio order."""
    texts: dict[int, list[str]] = {}
    for position, chunk in enumerate(chunks, 1):
        texts.setdefault(chunk["turn"], []).append(results[position])
    return texts


def timestamp(seconds: float) -> str:
    seconds = int(seconds)
    return f"{seconds // 3600:02d}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"


def render_markdown(source: str, turns: list[dict]) -> str:
    lines = [f"# {Path(source).name}", ""]
    for turn in turns:
        who = turn.get("name") or f"Speaker {turn['speaker']}"
        lines.append(f"**[{timestamp(turn['start'])}] {who}:** {turn['text']}")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def second_track_turns(turns: list[dict], after: int, name: str,
                       diarized: bool = False) -> list[dict]:
    """Label the second track so its speaker ids cannot collide with the first's.

    A microphone track that carries one voice -- the recorder's own room -- needs
    no clustering at all: every turn gets the id after the last remote speaker
    and the second track's name. With --diarize-second the track is clustered as
    usual and the ids are shifted, which keeps 1..N for remote participants and
    N+1.. for the room; the name is dropped, because several people share it.
    """
    if diarized:
        return [dict(turn, speaker=turn["speaker"] + after)
                for turn in number_speakers(turns)]
    return [dict(turn, speaker=after + 1, name=name) for turn in turns]


def match_speakers(first: list[dict], second: list[dict], offset: float = 0.0) -> list[dict]:
    """Give every second-track speaker the first-track speaker it overlaps most.

    Both tracks share a clock, so a voice heard at the same time is the same
    person. A voice that only speaks where the first track has nothing (the
    room kept recording) gets a new number after the last one.
    """
    shared: dict[tuple, float] = {}
    for other in second:
        start, end = other["start"] + offset, other["end"] + offset
        for turn in first:
            overlap = min(turn["end"], end) - max(turn["start"], start)
            if overlap > 0:
                key = (other["speaker"], turn["speaker"])
                shared[key] = shared.get(key, 0.0) + overlap
    free = max((turn["speaker"] for turn in first), default=0)
    mapping: dict = {}
    for speaker in sorted({turn["speaker"] for turn in second}):
        options = [(weight, number) for (own, number), weight in shared.items() if own == speaker]
        if options:
            mapping[speaker] = max(options)[1]
        else:
            free += 1
            mapping[speaker] = free
    return [dict(turn, speaker=mapping[turn["speaker"]]) for turn in second]


def speech_seconds(turns: list[dict]) -> float:
    return sum(max(0.0, turn["end"] - turn["start"]) for turn in turns)


def shared_seconds(first: list[dict], second: list[dict]) -> float:
    return sum(max(0.0, min(a["end"], b["end"]) - max(a["start"], b["start"]))
               for a in first for b in second)


def covered_share(turn: dict, turns: list[dict]) -> float:
    length = turn["end"] - turn["start"]
    if length <= 0:
        return 0.0
    return shared_seconds([turn], turns) / length


def redundant(first: list[dict], second: list[dict], offset: float = 0.0) -> bool:
    """Whether both tracks carry the same conversation, not two sides of it."""
    shifted = [dict(turn, start=turn["start"] + offset, end=turn["end"] + offset)
               for turn in second]
    shorter = min(speech_seconds(first), speech_seconds(shifted))
    return shorter > 0 and shared_seconds(first, shifted) / shorter >= REDUNDANT_SHARE


def duplicate_turn(turn: dict, first: list[dict]) -> bool:
    """Whether this second-track turn repeats audio the first track already has."""
    if covered_share(turn, first) >= COVERED_SHARE:
        return True
    words = set(bare(turn["text"]).split())
    for other in first:
        if abs(other["start"] - turn["start"]) > DUPLICATE_WINDOW_S:
            continue
        theirs = set(bare(other["text"]).split())
        union = words | theirs
        if union and len(words & theirs) / len(union) > COVERED_SHARE:
            return True
    return False


def dedupe_turns(turns: list[dict]) -> list[dict]:
    """Drop a turn that repeats the words of an earlier, overlapping one.

    The diarizer sometimes cuts the same utterance into two overlapping turns
    for two speaker ids; every clip then transcribes the same words twice. Only
    runs of three words or more are compared, so a shared "ja" stays two lines.
    """
    kept: list[dict] = []
    for turn in sorted(turns, key=lambda t: (t["start"], t["end"])):
        words = set(bare(turn["text"]).split())
        repeated = False
        for other in kept:
            if abs(other["start"] - turn["start"]) > DUPLICATE_WINDOW_S:
                continue
            if min(turn["end"], other["end"]) <= max(turn["start"], other["start"]):
                continue
            theirs = set(bare(other["text"]).split())
            union = words | theirs
            if min(len(words), len(theirs)) >= 3 and len(words & theirs) / len(union) > COVERED_SHARE:
                repeated = True
                break
        if not repeated:
            kept.append(turn)
    return kept


def merge_tracks(first: list[dict], second: list[dict], offset: float = 0.0) -> list[dict]:
    """Put both tracks on one timeline, the second shifted by `offset` seconds.

    Overlapping turns are kept as they are: two people talking at once are two
    lines here, not one garbled one, because the channels already separate them.
    When the tracks are the same room recorded twice, the second track's turns
    that the first already covers are dropped instead of repeated.
    """
    shifted = [dict(turn, start=round(turn["start"] + offset, 3),
                    end=round(turn["end"] + offset, 3)) for turn in second]
    if redundant(first, second, offset):
        shifted = [turn for turn in shifted if not duplicate_turn(turn, first)]
    return sorted(first + shifted, key=lambda turn: (turn["start"], turn["end"]))


PARAGRAPH_CHARS = 400   # a merged turn stays a paragraph, not a wall of text
PARAGRAPH_GAP = 1.0     # a longer silence is a break the speaker made


def merge_paragraphs(turns: list[dict], cap: float = PARAGRAPH_CHARS,
                     gap: float = PARAGRAPH_GAP) -> list[dict]:
    """Join the segments the model cut in the middle of a sentence.

    MOSS closes a segment every ~5 seconds whatever is being said, and its segment
    ends are rarely sentence ends: 34 of 44 turns on a real meeting stopped in the
    middle of a phrase, the speaker unchanged. Same speaker, a small gap and a
    sentence not finished yet means the model drew a line, not the speaker.

    Runs on the finished timeline, after the tracks are merged: a longer first-track
    turn would otherwise cover more of the microphone and duplicate_turn would drop
    words that are not duplicates.
    """
    out: list[dict] = []
    for turn in turns:
        last = out[-1] if out else None
        joined = f'{last["text"]} {turn["text"]}' if last else ""
        if (last and last["speaker"] == turn["speaker"]
                and 0 <= turn["start"] - last["end"] <= gap
                and not last["text"].rstrip().endswith(tuple(".!?…"))
                and len(joined) <= cap):
            last["end"] = max(last["end"], turn["end"])
            last["text"] = joined
            if turn.get("name") and not last.get("name"):
                last["name"] = turn["name"]
            continue
        out.append(dict(turn))
    return out


def mic_is_diarized(asr_mode: str, diarize_second: bool) -> bool:
    """Whether the microphone track needs the diarizer for its turn boundaries.

    A track that is not diarized goes to the ASR in one pass, which needs
    verbose_json to give the words timestamps. gufo answers text only, so with
    --asr-mode segments the microphone track is diarized anyway; the labels are
    kept when it found more than one voice, and collapsed to one speaker only
    when the room really had a single voice.
    """
    return diarize_second or asr_mode != "full"


def track_turns(args, url: str, source: Path, workdir: Path, hotwords: str,
                diarize_it: bool = True, lenient: bool = False) -> list[dict]:
    """Diarize (unless told not to) and transcribe one track; turns carry text.

    `workdir` belongs to this track alone: the diarizer container writes the
    normalized WAV there and the ASR reads it back, so two tracks sharing one
    directory would transcribe the same audio twice.

    A track that is not diarized is transcribed in one pass whatever --asr-mode
    says: there are no speaker turns to cut, and cutting would be inventing them.
    `lenient` turns a diarizer that found no speech into an empty track instead
    of failing the job; it is for a microphone track that may be silent.
    """
    workdir.mkdir(parents=True, exist_ok=True)
    if is_mistral_asr(args.model, args.asr_mode):
        return mistral_turns(args, source, workdir, hotwords, lenient)
    if args.asr_mode == "audiocpp":
        return audiocpp_turns(args, source, workdir, lenient)
    if diarize_it:
        segments = diarize(args.diarizer, source, workdir, args.speakers, args.threshold,
                           args.diarizer_timeout, args.min_speakers, args.max_speakers)
        if not segments:
            if lenient:
                return []
            raise SystemExit("diarizer found no speech")
        print(f"diarizer: {len(segments)} segments", file=sys.stderr)
        audio = workdir / "audio.wav"
    else:
        segments = []
        audio = source  # already a compact upload copy; nothing to normalize for the ASR

    if args.asr_mode == "full" or not diarize_it:
        # One request for the whole file: the diarizer only labels the ASR
        # segments. Nothing is cut, so nothing can be truncated.
        asr_segments = collapse_repetitions(transcribe_full(
            url, audio, args.model, args.language, hotwords, args.asr_timeout))
        if not asr_segments:
            raise SystemExit("ASR returned no segments")
        print(f"asr: {len(asr_segments)} segments in one pass", file=sys.stderr)
        return build_turns_labeled(fuse_segments(asr_segments, segments), args.merge_gap)

    turns = pad_turns(number_speakers(build_turns(segments, args.merge_gap)), TURN_PAD_S)
    chunks = [chunk for index, turn in enumerate(turns)
              for chunk in split_turn(turn, index, args.max_segment)]
    print(f"transcribing {len(chunks)} clips for {len(turns)} turns", file=sys.stderr)

    def work(chunk: dict) -> str:
        if chunk["end"] - chunk["start"] < MIN_CLIP_S:
            return ""
        clip = slice_wav(audio, chunk["start"], chunk["end"])
        return transcribe(url, clip, args.model, args.language, hotwords,
                          args.asr_timeout, max_tokens=args.max_tokens)

    def progress(done: int, chunk: dict, text: str) -> None:
        print(f"  [{done}/{len(chunks)}] {timestamp(chunk['start'])} "
              f"speaker {chunk['speaker']}: {text[:60]}", file=sys.stderr)

    results = run_parallel(chunks, work, args.parallel, progress)
    texts = ordered_texts(chunks, results)
    return [dict(turn, text=" ".join(texts.get(index, [])).strip())
            for index, turn in enumerate(turns)]


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Diarized transcript via an OpenAI-compatible ASR + a diarizer container.")
    parser.add_argument("input", type=Path, help="audio or video file, any format ffmpeg reads")
    parser.add_argument("--output", type=Path, default=None,
                        help="output prefix; writes PREFIX.md and PREFIX.json (default next to input)")
    parser.add_argument("--asr", default=DEFAULT_ASR,
                        help=f"ASR base URL (default {DEFAULT_ASR})")
    parser.add_argument("--model", default=DEFAULT_ASR_MODEL, help=f"ASR model (default {DEFAULT_ASR_MODEL})")
    parser.add_argument("--diarizer", default=DEFAULT_DIARIZER,
                        choices=("sherpa", "pyannote-rocm", "nemotron"),
                        help=f"diarizer backend (default {DEFAULT_DIARIZER})")
    parser.add_argument("--asr-dir", type=Path, default=None,
                        help="with --asr-mode audiocpp: a directory this process writes and "
                             "the ASR server reads, because audio.cpp takes a path, not an upload")
    parser.add_argument("--asr-remote-dir", default=None,
                        help="how --asr-dir is seen by the ASR server, when the two differ "
                             "(default: the same path)")
    parser.add_argument("--asr-mode", default="full",
                        choices=("segments", "full", "audiocpp", "mistral"),
                        help="full: one request for the whole normalized file plus segment-level "
                             "fusion with the diarizer (the default; needs an OpenAI-compatible "
                             "verbose_json endpoint, e.g. Lemonade on :8731 with Whisper); "
                             "segments: one ASR request per turn clip, the gufo-safe path; "
                             "audiocpp: one request to audio.cpp, which diarizes itself and "
                             "returns the turns, so no diarizer runs at all (needs --asr-dir); "
                             "mistral: one request to Mistral's /v1/audio/transcriptions with "
                             "diarize=true (auto-selected for voxtral-* models)")
    parser.add_argument("--mistral-url", default=MISTRAL_URL,
                        help=f"Mistral API base URL (default {MISTRAL_URL})")
    parser.add_argument("--mistral-key", default=os.environ.get("MISTRAL_API_KEY", ""),
                        help="Mistral API key (default $MISTRAL_API_KEY)")
    parser.add_argument("--speakers", type=int, default=-1,
                        help="known speaker count; -1 lets clustering decide (default)")
    parser.add_argument("--min-speakers", type=int, default=-1,
                        help="fewest speakers to expect, pyannote only (default: no bound)")
    parser.add_argument("--max-speakers", type=int, default=-1,
                        help="most speakers to expect, pyannote only (default: no bound)")
    parser.add_argument("--threshold", type=float, default=0.5,
                        help="sherpa clustering threshold when --speakers is -1 (default 0.5)")
    parser.add_argument("--language", default=None, help="force a language, e.g. German or de")
    parser.add_argument("--hotwords", default=None, help="context/hotwords passed to the ASR prompt")
    parser.add_argument("--names", default=None,
                        help='name the speakers, e.g. "1:Anna,2:Bernd"; the names also go '
                             "into the ASR hotwords")
    parser.add_argument("--second", type=Path, default=None,
                        help="second track of the same recording (the microphone side). It is "
                             "labelled as one speaker, with --second-name; --diarize-second "
                             "diarizes it instead, and --second-offset shifts it in time")
    parser.add_argument("--second-name", default="Me",
                        help="name of the second track's speaker (default Me)")
    parser.add_argument("--diarize-second", action="store_true",
                        help="label several people in the second track instead of one "
                             "speaker (default: one speaker, which is what a microphone "
                             "track is; its turn boundaries still come from the diarizer)")
    parser.add_argument("--second-offset", type=float, default=0.0,
                        help="seconds to add to the second track's timestamps when its file "
                             "starts later than the first (default 0)")
    parser.add_argument("--diarization", type=Path, default=None,
                        help="external diarization JSON to take the speakers from, e.g. a "
                             "pyannote run: {\"diarization\": [{start, end, speaker}]} or a "
                             "plain list; the final turns are relabelled by time overlap")
    parser.add_argument("--merge-gap", type=float, default=2.0,
                        help="merge same-speaker segments up to this gap in seconds (default 2.0)")
    parser.add_argument("--max-segment", type=float, default=MAX_SEGMENT_S,
                        help=f"longest clip sent to the ASR in seconds (default {MAX_SEGMENT_S:g},\n"
                             "one audio chunk of the ASR; longer clips lose their tail)")
    parser.add_argument("--max-tokens", type=int, default=MAX_TOKENS,
                        help=f"output cap per clip/chunk (default {MAX_TOKENS}, the endpoint's "
                             "maximum; 0 leaves the choice to the endpoint, which truncates sooner)")
    parser.add_argument("--diarizer-timeout", type=float, default=7200,
                        help="seconds to allow the diarizer container (default 7200)")
    parser.add_argument("--asr-timeout", type=float, default=600,
                        help="seconds to allow one ASR transcription (default 600)")
    parser.add_argument("--parallel", type=int, default=4,
                        help="transcriptions in flight at once (default 4; 1 is sequential)")
    args = parser.parse_args()

    source = args.input.resolve()
    if not source.is_file():
        raise SystemExit(f"No such audio file: {source}")
    second_source = args.second.resolve() if args.second else None
    if second_source is not None and not second_source.is_file():
        raise SystemExit(f"No such audio file: {second_source}")
    if args.diarization is not None and not args.diarization.is_file():
        raise SystemExit(f"No such diarization file: {args.diarization}")
    if args.diarizer != "pyannote-rocm" and (args.min_speakers > 0 or args.max_speakers > 0):
        raise SystemExit("--min-speakers/--max-speakers need --diarizer pyannote-rocm")
    if args.diarizer != "sherpa" and args.threshold != 0.5:
        print("note: --threshold only applies to --diarizer sherpa", file=sys.stderr)
    names = parse_names(args.names)
    hotwords = ", ".join(part for part in (args.hotwords, ", ".join(names.values())) if part)
    prefix = args.output or source.with_suffix("")
    url = args.asr.rstrip("/") + "/v1/audio/transcriptions"
    if args.asr_mode == "audiocpp" and not is_mistral_asr(args.model, args.asr_mode) and not args.asr_dir:
        raise SystemExit("--asr-mode audiocpp needs --asr-dir: audio.cpp reads the audio from "
                         "a path, so the normalized WAV must sit where it can open it")
    if args.asr_mode == "full" and args.model == "qwen3-asr-1.7b":
        print("note: --asr-mode full needs a verbose_json endpoint; gufo's qwen3-asr-1.7b "
              "returns text only. Use --asr-mode segments with it.", file=sys.stderr)

    # Next to the outputs, not /tmp: the diarizer container mounts this path, and
    # a service running in a container cannot see the host's /tmp.
    duration: float | None = None
    with tempfile.TemporaryDirectory(prefix="meeting-", dir=prefix.parent) as temporary:
        workdir = Path(temporary)
        labelled = number_speakers(track_turns(args, url, source, workdir / "main", hotwords))
        duration = wav_seconds(workdir / "main" / "audio.wav")
        if second_source is not None:
            # With gufo there is no verbose_json, so the microphone track takes
            # the per-turn path: the diarizer supplies the boundaries, and its
            # labels too when the room turns out to hold several voices.
            needs_diarizer = mic_is_diarized(args.asr_mode, args.diarize_second)
            second = track_turns(args, url, second_source, workdir / "second", hotwords,
                                 diarize_it=needs_diarizer,
                                 lenient=needs_diarizer and not args.diarize_second)
            after = max((t["speaker"] for t in labelled), default=0)
            voices = len({turn["speaker"] for turn in second})
            if args.diarize_second:
                second = second_track_turns(second, after, args.second_name, diarized=True)
            elif (is_mistral_asr(args.model, args.asr_mode)
                    and redundant(labelled, second, args.second_offset)):
                # Voxtral diarizes each track on its own, so the microphone
                # track that hears the same room again gets its own speaker_1,
                # speaker_2, ... — which would show up as extra speakers the
                # system track never saw. The shared clock says which
                # first-track speaker each mic voice is (49% of the mic track's
                # speech overlapped the system track in the zoom-20261110
                # recording), so match them instead of shifting the ids.
                second = match_speakers(labelled, second, args.second_offset)
            elif voices > 1 and redundant(labelled, second, args.second_offset):
                # The same room recorded twice, with several voices in it:
                # calling all of them "Me" would be a lie, and the shared clock
                # says which first-track speaker each one is.
                second = match_speakers(labelled, second, args.second_offset)
            elif voices > 1:
                second = second_track_turns(second, after, args.second_name, diarized=True)
            else:
                second = second_track_turns(second, after, args.second_name)
            labelled = merge_tracks(labelled, second, args.second_offset)
            print(f"second track: {len(second)} turns added", file=sys.stderr)
            second_duration = wav_seconds(workdir / "second" / "audio.wav")
            if second_duration:
                duration = max(duration or 0.0, second_duration)
        print(f"{len(labelled)} turns in total", file=sys.stderr)

    if args.diarization is not None:
        labelled = relabel_turns(labelled, load_diarization(args.diarization))
        print(f"relabelled from {args.diarization}: "
              f"{len({turn['speaker'] for turn in labelled})} speakers", file=sys.stderr)
    labelled = dedupe_turns(labelled)
    print(f"{len(labelled)} turns after removing repeated cuts", file=sys.stderr)
    if args.asr_mode == "audiocpp" or is_mistral_asr(args.model, args.asr_mode):
        before = len(labelled)
        labelled = merge_paragraphs(labelled)
        if len(labelled) < before:
            print(f"{len(labelled)} paragraphs after joining what the model split",
                  file=sys.stderr)

    result = []
    for turn in labelled:
        if not turn["text"]:
            continue
        entry = dict(turn)
        name = names.get(turn["speaker"]) or turn.get("name")
        if name:
            entry["name"] = name
        result.append(entry)
    if result:
        # Never shorter than the last turn, even when only one track reported it.
        duration = round(max(duration or 0.0, max(turn["end"] for turn in result)), 1)
    document = {"source": str(source), "model": args.model, "language": args.language,
                # The recording's length, so a client does not have to guess it
                # from the last turn (which ends where the speech ends).
                "duration": duration, "turns": result}
    if second_source is not None:
        document["second"] = str(second_source)
    Path(f"{prefix}.json").write_text(json.dumps(document, ensure_ascii=False, indent=2) + "\n",
                                      encoding="utf-8")
    Path(f"{prefix}.md").write_text(render_markdown(str(source), result), encoding="utf-8")
    print(f"wrote {prefix}.json and {prefix}.md", file=sys.stderr)


if __name__ == "__main__":
    main()
