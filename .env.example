# meeting-stack compose environment.
# Copy to .env (docker compose reads that file; it is gitignored) and fill in.
# Quote values that contain #, $ or spaces.
MEETING_TOKEN=
MISTRAL_API_KEY=
UNSLOTH_API_KEY=
UBUNTU_HOST=

# Batch diarization model. The API cannot override it per job.
BATCH_MODEL=unsloth.MOSS-Transcribe-Diarize

# WebDAV archive for the files meeting-job receives. Without WEBDAV_URL the
# service still records every upload in its SQLite ledger, but copies nothing.
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=
WEBDAV_DIR=meeting-stack
