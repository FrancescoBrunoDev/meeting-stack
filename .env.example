# WebDAV archive for the files meeting-job receives.
# Copy to .env (docker compose reads that file; it is gitignored) and fill in.
# Quote values that contain #, $ or spaces. Without WEBDAV_URL the service still
# records every upload in its SQLite ledger, but copies nothing to WebDAV.
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=
WEBDAV_DIR=meeting-stack
