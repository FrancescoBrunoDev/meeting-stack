                        default=(Path(os.environ["ARCHIVE_DB"])
                                 if os.environ.get("ARCHIVE_DB") else None),
                        help="SQLite ledger of received files and their WebDAV copies "
                             "(default $ARCHIVE_DB or <dir>/archive.db)")
