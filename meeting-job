    parser.add_argument("--webdav-password", default=os.environ.get("WEBDAV_PASSWORD", ""),
                        help="WebDAV password (default $WEBDAV_PASSWORD)")
    parser.add_argument("--webdav-dir", default=os.environ.get("WEBDAV_DIR", "meeting-stack"),
                        help="folder under the WebDAV root (default meeting-stack)")
    args = parser.parse_args()

    webdav = (WebDAV(args.webdav_url, args.webdav_user, args.webdav_password,
                     args.webdav_dir)
              if args.webdav_url else None)
    jobs = Jobs(args.meeting, args.dir.expanduser(), args.keep_audio, args.job_timeout,
                args.asr, args.model,
                args.asr_dir, args.asr_remote_dir,
                retain_days=args.retain_audio_days,
                archive_db=args.archive_db.expanduser() if args.archive_db else None,
                webdav=webdav)
    hooks = Hooks(args.dir.expanduser() / "hooks.json")
    server = Server((args.host, args.port), jobs, hooks, args.token, args.max_upload)
    auth = "bearer token required" if args.token else "NO AUTH: anyone who can reach the port can use it"
    print(f"meeting-job on http://{args.host}:{args.port}  ({auth})", flush=True)
    print(f"archive: {'WebDAV ' + args.webdav_url if webdav else 'ledger only (set WEBDAV_URL)'}",
          flush=True)

    def shutdown(signum, frame) -> None:
        jobs.stop()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    server.serve_forever()

if __name__ == "__main__":
    main()
