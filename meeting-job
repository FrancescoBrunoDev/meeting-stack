def job_id(audio: bytes) -> str:
    return hashlib.sha256(audio).hexdigest()[:16]

JOB_ID = re.compile(r"^[0-9a-f]{16}$")

def write_atomic(path: Path, text: str) -> None:
    """Replace a small file in one step: the service is restarted mid-write."""
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)

ARCHIVE_SCHEMA = """
CREATE TABLE IF NOT EXISTS files (
    job_id TEXT NOT NULL,
    track TEXT NOT NULL,
    filename TEXT NOT NULL,
    size INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    received_at REAL NOT NULL,
    status TEXT NOT NULL,
    error TEXT,
    archived_at REAL,
    webdav_url TEXT,
    archive_error TEXT,
    PRIMARY KEY (job_id, track)
)
"""

class WebDAV:
    """The one WebDAV write this service needs: make the folders, PUT the file."""

    def __init__(self, url: str, user: str = "", password: str = "",
                 directory: str = "meeting-stack", timeout: float = 120) -> None:
        self.base = url.rstrip("/")
        self.user = user
        self.password = password
        self.directory = directory.strip("/")
        self.timeout = timeout
        self._folders: set[str] = set()

    def put(self, name: str, data: bytes, folder: str | None = None) -> str:
        """Archive one file under `folder`; returns the URL it was written to."""
        self.ensure(folder=folder)
        url = self._url(self._parts() + ([folder] if folder else []) + [name])
        self._request("PUT", url, data)
        return url

    def ensure(self, timeout: float | None = None, force: bool = False,
               folder: str | None = None) -> str:
        """Make the archive folder (and `folder` under it); return its URL.

        A 405 means it was there. force skips the created-folder cache, which is
        what the status probe needs: otherwise a check after the first one would
        never touch the wire.
        """
        parts = self._parts() + ([folder] if folder else [])
        # PUT does not create parents: MKCOL each folder once, then remember it.
        for depth in range(1, len(parts) + 1):
            target = self._url(parts[:depth])
            if force or target not in self._folders:
                self._mkcol(target, timeout=timeout)
                self._folders.add(target)
        return self._url(parts) if parts else self.base

    def target(self) -> str:
        parts = self._parts()
        return self._url(parts) if parts else self.base

    def folder_url(self, folder: str) -> str:
        return self._url(self._parts() + [folder])

    def _parts(self) -> list[str]:
        return [part for part in self.directory.split("/") if part]

    def _url(self, parts: list[str]) -> str:
        return f"{self.base}/" + "/".join(
            urllib.parse.quote(part, safe="") for part in parts)

    def _mkcol(self, url: str, timeout: float | None = None) -> None:
        try:
            self._request("MKCOL", url, timeout=timeout)
        except urllib.error.HTTPError as error:
            if error.code != 405:  # 405: the collection is already there
                raise

    def _request(self, method: str, url: str, data: bytes | None = None,
                 timeout: float | None = None) -> None:
        request = urllib.request.Request(url, data=data, method=method)
        if self.user or self.password:
            token = base64.b64encode(f"{self.user}:{self.password}".encode()).decode()
            request.add_header("Authorization", f"Basic {token}")
        if data is not None:
            request.add_header("Content-Type", "application/octet-stream")
        with urllib.request.urlopen(request, timeout=timeout or self.timeout):
            pass


class Archive:
    """The file ledger (SQLite) and the WebDAV copy of every upload.

    A file is recorded the moment it lands, marked running/done/error with its
    job, and PUT to WebDAV when the job ends. A WebDAV failure is recorded on
    the row and never fails the job: the local file is still there.
    """

    def __init__(self, db: Path | None, webdav: WebDAV | None = None) -> None:
        self.db = Path(db) if db is not None else None
        self.webdav = webdav
        self._lock = threading.Lock()
        self._conn: sqlite3.Connection | None = None
        self._check: dict | None = None
        self._checked = 0.0
        if self.db is not None:
            self.db.parent.mkdir(parents=True, exist_ok=True)
            # One connection, used under the lock: the handler threads read the
            # ledger while the worker writes it.
            self._conn = sqlite3.connect(self.db, timeout=10, check_same_thread=False)
            self._conn.row_factory = sqlite3.Row
            self._conn.execute("PRAGMA journal_mode=WAL")
            self._conn.execute(ARCHIVE_SCHEMA)
            self._conn.commit()

    def _write(self, sql: str, params: tuple) -> None:
        with self._lock:
            self._conn.execute(sql, params)
            self._conn.commit()

    def received(self, job_id: str, track: str, filename: str, audio: bytes) -> None:
        """Insert the audio row, or refresh it when the same file is uploaded again."""
        if self._conn is None:
            return
        self._write(
            "INSERT INTO files (job_id, track, filename, size, sha256, received_at, status)"
            " VALUES (?, ?, ?, ?, ?, ?, 'received')"
            " ON CONFLICT(job_id, track) DO UPDATE SET filename=excluded.filename,"
            " size=excluded.size, sha256=excluded.sha256,"
            " received_at=excluded.received_at, status='received', error=NULL,"
            " archived_at=NULL, webdav_url=NULL, archive_error=NULL",
            (job_id, track, Path(filename).name, len(audio),
             hashlib.sha256(audio).hexdigest(), time.time()))

    def status(self, job_id: str, status: str, error: str | None = None) -> None:
        if self._conn is None:
            return
        self._write("UPDATE files SET status=?, error=? WHERE job_id=?",
                    (status, error, job_id))

    def finish(self, job: "Job") -> None:
        """Record the transcript beside the audio, then archive the job folder."""
        if self._conn is None:
            return
        self.status(job.id, job.status, job.error)
        artifacts = []
        if job.markdown:
            artifacts.append(("transcript.md", job.markdown.encode()))
        if job.json is not None:
            artifacts.append(("transcript.json",
                              json.dumps(job.json, ensure_ascii=False).encode()))
        for track, data in artifacts:
            self._store(job.id, track, track, data, "done")
        if self.webdav is None:
            return
        for path in job.tracks.values():
            if path.is_file():
                self._put(job.id, "audio", path.read_bytes())
        for track, data in artifacts:
            self._put(job.id, track, data)

    def _store(self, job_id: str, track: str, filename: str, data: bytes,
               status: str) -> None:
        self._write(
            "INSERT INTO files (job_id, track, filename, size, sha256, received_at, status)"
            " VALUES (?, ?, ?, ?, ?, ?, ?)"
            " ON CONFLICT(job_id, track) DO UPDATE SET filename=excluded.filename,"
            " size=excluded.size, sha256=excluded.sha256, status=excluded.status,"
            " error=NULL, archived_at=NULL, webdav_url=NULL, archive_error=NULL",
            (job_id, track, filename, len(data), hashlib.sha256(data).hexdigest(),
             time.time(), status))

    def _put(self, job_id: str, track: str, data: bytes) -> None:
        with self._lock:
            row = self._conn.execute("SELECT filename FROM files"
                                     " WHERE job_id=? AND track=?",
                                     (job_id, track)).fetchone()
        if row is None:
            return
        name = (f"audio-{Path(row['filename']).name}" if track == "audio"
                else Path(row["filename"]).name)
        # shortcut: one PUT in memory, and the worker waits for it; stream it and
        # move it off-thread if uploads grow past a few hundred MB.
        try:
            url = self.webdav.put(name, data, folder=job_id)
        except Exception as error:  # never let the archive take a job down
            detail = f"{type(error).__name__}: {error}"[:300]
            self._write("UPDATE files SET archive_error=?"
                        " WHERE job_id=? AND track=?", (detail, job_id, track))
            print(f"archive: {job_id}/{track} not on WebDAV: {detail}", flush=True)
        else:
            self._write("UPDATE files SET archived_at=?, webdav_url=?, archive_error=NULL"
                        " WHERE job_id=? AND track=?",
                        (time.time(), url, job_id, track))

    def archived(self, job_id: str) -> bool:
        """True when every file has its WebDAV copy, or WebDAV is not configured."""
        if self._conn is None or self.webdav is None:
            return True
        with self._lock:
            missing = self._conn.execute(
                "SELECT COUNT(*) FROM files WHERE job_id=? AND archived_at IS NULL",
                (job_id,)).fetchone()[0]
        return missing == 0

    def job_state(self, job_id: str) -> dict | None:
        """What the dashboard shows for one job: archived, failed, pending or off."""
        if self._conn is None:
            return None
        with self._lock:
            rows = self._conn.execute(
                "SELECT archived_at, webdav_url, archive_error FROM files"
                " WHERE job_id=? ORDER BY track", (job_id,)).fetchall()
        if not rows:
            return None
        if all(row["archived_at"] for row in rows):
            state = "archived"
        elif any(row["archive_error"] for row in rows):
            state = "failed"
        elif self.webdav is None:
            state = "off"
        else:
            state = "pending"
        return {"state": state,
                "url": next((row["webdav_url"] for row in rows if row["webdav_url"]), None),
                "folder": self.webdav.folder_url(job_id) if self.webdav else None,
                "error": next((row["archive_error"] for row in rows if row["archive_error"]), None),
                "files": len(rows)}

    def check(self, max_age: float = 30) -> dict:
        """Probe WebDAV (MKCOL the folder) at most once per max_age seconds."""
        if self.webdav is None:
            return {"configured": False, "reachable": None, "error": None, "url": None}
        now = time.time()
        with self._lock:
            if self._check is not None and now - self._checked < max_age:
                return self._check
        try:
            # A dashboard probe must not hang, and must hit the wire every time.
            url = self.webdav.ensure(timeout=10, force=True)
        except Exception as error:  # a status probe must answer, not 500
            result = {"configured": True, "reachable": False,
                      "error": f"{type(error).__name__}: {error}"[:300],
                      "url": self.webdav.target()}
        else:
            result = {"configured": True, "reachable": True, "error": None, "url": url}
        with self._lock:
            self._check, self._checked = result, now
        return result

    def rows(self, limit: int = 500) -> list[dict]:
        """The ledger, newest first, for GET /files."""
        if self._conn is None:
            return []
        with self._lock:
            return [dict(row) for row in self._conn.execute(
                "SELECT * FROM files ORDER BY received_at DESC LIMIT ?", (limit,))]


def byte_range(header: str | None, size: int) -> tuple[int, int] | None:
    """Parse a single `Range: bytes=a-b` against a file of `size` bytes.

    Returns the inclusive span to send, or None for "send the whole file" --
    which is also what a malformed or unsatisfiable range gets, because every
    browser copes with a plain 200. `bytes=-500` (a suffix range, used by some
    players for the last frames) is handled too.
    """
    if not header or not header.startswith("bytes=") or size <= 0:
        return None
    start, _, end = header[6:].split(",")[0].strip().partition("-")
    try:
        if not start:
            length = int(end)
            return (max(0, size - length), size - 1) if length > 0 else None
        first = int(start)
        last = int(end) if end else size - 1
    except ValueError:
        return None
    if first >= size:
        return None
    return first, min(last, size - 1)

def safe_suffix(filename: str | None) -> str:
    suffix = Path(filename or "").suffix.lower()
    return suffix if SUFFIX.fullmatch(suffix) else ".bin"

RECORDING_STAMP = re.compile(r"^(?P<day>\d{4}-\d{2}-\d{2})/(?P<time>\d{2}-\d{2}-\d{2})$")

def recording_pair(day: str, recording: str) -> str | None:
    """('<2026-10-20>', '<12-35-09>') -> 'zoom-20261020-123509'.

    The recorder announces a recording with the day and time of its folder; the
    upload arrives with its own file name, so the two have to agree on one key.
    """
    match = RECORDING_STAMP.match(f"{day}/{recording}".strip())
    if not match:
        return None
    return "zoom-" + match.group("day").replace("-", "") + "-" + match.group("time").replace("-", "")

class Hooks:
    """Recordings the recorder announced as complete (POST /hook).

    The audio still arrives through POST /jobs - this only remembers the
    announcement, so a recording that was announced and never uploaded can be
    seen. On disk, because the job list is in memory but a skipped announcement
    is not worth losing.
    """

    def __init__(self, path: Path) -> None:
        self.path = Path(path)
        self._lock = threading.Lock()
        self._items: dict[str, dict] = {}
        self._load()

    def _load(self) -> None:
        try:
            data = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return
        if isinstance(data, list):
            self._items = {item["pair"]: item for item in data
                           if isinstance(item, dict) and item.get("pair")}

    def _save(self) -> None:
        # Atomic: the service is restarted while a hook is being written.
        write_atomic(self.path, json.dumps(list(self._items.values()), indent=1))

    def announce(self, payload: dict) -> tuple[dict | None, str | None]:
        """Remember one announcement. (entry, error) - error is a 400 reason."""
        if not isinstance(payload, dict):
            return None, "body must be a JSON object"
        day, recording = str(payload.get("day") or ""), str(payload.get("recording") or "")
        pair = recording_pair(day, recording)
        if pair is None:
            return None, "expected day=YYYY-MM-DD and recording=HH-MM-SS"
        files = [str(name) for name in (payload.get("files") or []) if str(name).strip()]
        now = time.time()
        with self._lock:
            entry = self._items.get(pair)
            if entry is None:
                entry = {"pair": pair, "id": f"{day}/{recording}", "day": day,
                         "recording": recording, "first_seen": now, "count": 0}
                self._items[pair] = entry
            entry.update({"remote_dir": str(payload.get("remote_dir") or ""),
                          "files": files, "last_seen": now,
                          # what the recorder was told the call was in; the
                          # audio itself already arrived with it as a job option
                          "language": str(payload.get("language") or ""),
                          "count": int(entry.get("count", 0)) + 1})
            self._save()
            return dict(entry), None

    def get(self, pair: str) -> dict | None:
        with self._lock:
            entry = self._items.get(pair)
            return dict(entry) if entry else None

    def list(self) -> list[dict]:
        with self._lock:
            return [dict(entry) for entry in self._items.values()]

def hook_view(hooks: Hooks, jobs: Jobs, pair: str | None = None) -> list[dict]:
    """Every announcement joined with the job whose upload matches its file, if any."""
    entries = [hooks.get(pair)] if pair else hooks.list()
    candidates = jobs.list()
    views = []
    for entry in entries:
        if entry is None:
            continue
        announced = {Path(name).name for name in entry.get("files") or []}
        job = next((candidate for candidate in candidates
                    if candidate.get("filename") in announced), None)
        if job is None:
            # Announced as ready, never uploaded: the recorder has the file,
            # the worker does not - that is the state worth seeing.
            state = "missing_audio"
        else:
            state = job["status"]
        views.append({**entry, "job": job["id"] if job else None, "status": state})
    return views

class Job:
    def __init__(self, identity: str, options: dict) -> None:
        self.id = identity
        # One recording, already mixed: the ASR diarizes and transcribes it.
        self.tracks: dict[str, Path] = {}
        self.filename: str | None = None
        self.options = options
        self.status = "queued"
        self.error: str | None = None
        self.progress: str | None = None
        self.json: dict | None = None
        self.markdown: str | None = None
        self.created = time.time()
        self.started: float | None = None
        self.finished: float | None = None

    @property
    def audio(self) -> Path | None:
        """The uploaded recording."""
        return next(iter(self.tracks.values()), None)

    @property
    def duration(self) -> float | None:
        """How long the recording is; older results only have the last turn's end."""
        if not self.json:
            return None
        if self.json.get("duration"):
            return round(float(self.json["duration"]), 1)
        turns = self.json.get("turns") or []
        return round(max(turn["end"] for turn in turns), 1) if turns else None

    def snapshot(self) -> dict:
        audio = self.audio
        return {"id": self.id, "status": self.status, "error": self.error,
                "options": self.options, "created": self.created,
                "started": self.started, "finished": self.finished,
                "progress": self.progress, "filename": self.filename,
                "json": self.json, "markdown": self.markdown,
                "tracks": sorted(self.tracks),
                # Length of the recording, not how long the job took.
                "duration": self.duration,
                # False once the audio is gone (deleted after a job, or --keep-audio off)
                "audio": bool(audio and audio.is_file())}

class Jobs:
    """A single-worker FIFO queue of transcription jobs, kept in memory."""

    def __init__(self, meeting: Path, root: Path, keep_audio: bool = True,
                 timeout: float = 14400, asr: str = "http://ubuntu:8090",
                 model: str = "moss-transcribe-diarize",
                 asr_dir: str | None = None, asr_remote_dir: str | None = None,
                 retain_days: float = 30,
                 archive_db: Path | None = None,
                 webdav: WebDAV | None = None) -> None:
        self.meeting = Path(meeting).resolve()
        self.asr = asr
        self.model = model
        self.asr_dir = asr_dir
        self.asr_remote_dir = asr_remote_dir
        self.inbox = root / "inbox"
        self.out = root / "out"
        self.jobs_file = root / "jobs.json"
        self.retain_days = retain_days
        self.keep_audio = keep_audio
        self.timeout = timeout
        self.inbox.mkdir(parents=True, exist_ok=True)
        self.out.mkdir(parents=True, exist_ok=True)
        self.archive = Archive(archive_db or (root / "archive.db"), webdav)
        self._jobs: dict[str, Job] = {}
        # RLock: a state change is persisted while the submitter holds the lock.
        self._lock = threading.RLock()
        self._current: subprocess.Popen | None = None
        self._current_job: Job | None = None
        self._current_lock = threading.Lock()
        self._queue: queue.Queue[Job] = queue.Queue()
        self._load()
        self.prune()
        threading.Thread(target=self._work, daemon=True).start()

    def submit(self, audio: bytes, options: dict, filename: str | None = None) -> dict:
        options = dict(options or {})
        options.pop("model", None)  # the service owns the batch model; see --model
        identity = job_id(audio)
        with self._lock:
            job = self._jobs.get(identity)
            if job is None:
                job = Job(identity, options)
                self._jobs[identity] = job
            elif job.status != "error":
                return self._view(job)  # the same file again: nothing to do
            path = self.inbox / (identity + safe_suffix(filename))
            path.write_bytes(audio)
            job.tracks["main"] = path
            job.filename = Path(filename or path.name).name
            job.options = options or job.options
            self.archive.received(job.id, "audio", job.filename, audio)
            job.status = "queued"
            self._queue.put(job)
            self._persist()
            return self._view(job)

    def _persist(self) -> None:
        """Keep the job list on disk: a restart empties the queue, not the list."""
        with self._lock:
            records = [{"id": job.id, "status": job.status, "error": job.error,
                        "options": job.options, "created": job.created,
                        "started": job.started, "finished": job.finished,
                        "progress": job.progress, "filename": job.filename,
                        "tracks": {name: str(path) for name, path in job.tracks.items()}}
                       for job in self._jobs.values()]
            try:
                write_atomic(self.jobs_file, json.dumps(records, ensure_ascii=False))
            except OSError:
                pass  # a full disk must not take a running job down with it

    def _load(self) -> None:
        """Restore what a previous process wrote; results are read back lazily."""
        try:
            records = json.loads(self.jobs_file.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return
        for record in records if isinstance(records, list) else []:
            try:
                identity = record["id"]
                options = record.get("options") or {}
                tracks = record.get("tracks") or {}
                if not JOB_ID.fullmatch(identity) or not isinstance(options, dict) \
                        or not isinstance(tracks, dict):
                    continue
                job = Job(identity, dict(options))
                job.status = str(record.get("status") or "error")
                job.error = record.get("error") or None
                job.progress = record.get("progress") or None
                job.filename = record.get("filename") or None
                job.created = float(record.get("created") or 0.0)
                job.started = record.get("started")
                job.finished = record.get("finished")
                job.tracks = {name: Path(path) for name, path in tracks.items()
                              if name in ("main", "second") and isinstance(path, str)}
            except (KeyError, TypeError, ValueError):
                continue
            self._restore(job)
            self.archive.status(job.id, job.status, job.error)
            self._jobs[job.id] = job
        self._persist()

    def _restore(self, job: Job) -> None:
        """Reconcile one restored job with what is actually on disk."""
        if job.status == "done":
            try:
                job.json = json.loads(Path(f"{self.out / job.id}.json")
                                      .read_text(encoding="utf-8"))
                job.markdown = Path(f"{self.out / job.id}.md").read_text(encoding="utf-8")
            except (OSError, json.JSONDecodeError):
                job.status, job.error = "error", "the result files are gone"
        elif job.status == "running":
            # The worker died with the service; the audio is kept for a retry.
            job.status = "error"
            job.error = "the service restarted while this job was running"
            job.finished = time.time()
        elif job.status not in ("waiting", "queued", "cancelled"):
            job.status, job.error = "error", f"unknown job status {job.status!r}"
        if job.status != "done" and not any(path.is_file() for path in job.tracks.values()):
            job.status, job.error = "error", "the uploaded audio is gone"
        elif job.status in ("waiting", "queued"):
            job.status = "queued"  # an old two-track wait; the file is all we need
            self._queue.put(job)

    def prune(self) -> int:
        """Delete kept uploads past --retain-audio-days; 0 disables pruning.

        A job that still has to run keeps its audio whatever its age: only the
        recordings of done and failed jobs are candidates.
        """
        if self.retain_days <= 0:
            return 0
        cutoff = time.time() - self.retain_days * 86400
        removed = 0
        with self._lock:
            needed = {path for job in self._jobs.values()
                      if job.status in ("queued", "waiting", "running")
                      for path in job.tracks.values()}
            for path in self.inbox.iterdir():
                try:
                    if path not in needed and path.is_file() \
                            and path.stat().st_mtime < cutoff:
                        path.unlink()
                        removed += 1
                except OSError:
                    continue
        return removed

    def _view(self, job: Job) -> dict:
        view = job.snapshot()
        view["archive"] = self.archive.job_state(job.id)
        return view

    def get(self, identity: str | None) -> dict | None:
        with self._lock:
            job = self._jobs.get(identity or "")
            return self._view(job) if job else None

    def audio_path(self, identity: str | None) -> Path | None:
        """The uploaded audio, if the job exists and the file was kept."""
        with self._lock:
            job = self._jobs.get(identity or "")
            audio = job.audio if job is not None else None
            return audio if audio is not None and audio.is_file() else None

    def list(self) -> list[dict]:
        with self._lock:
            return [self._view(job) for job in self._jobs.values()]

    def retry(self, identity: str | None) -> dict | None:
        """Run a finished job again from the audio still in the inbox.

        Returns the job unchanged when it is not finished (already queued or
        running) or when the audio is gone, so a double click on the dashboard's
        retry button cannot put the same job in the queue twice.
        """
        with self._lock:
            job = self._jobs.get(identity or "")
            if job is None:
                return None
            if job.status not in ("done", "error", "cancelled"):
                return self._view(job)
            if not all(path.is_file() for path in job.tracks.values()):
                return self._view(job)
            job.status, job.error, job.progress = "queued", None, None
            self.archive.status(job.id, "queued")
            job.started = job.finished = None
            job.json = job.markdown = None  # the previous result is not this run's
            self._queue.put(job)
            self._persist()
            return self._view(job)

    def cancel(self, identity: str | None) -> dict | None:
        """Stop a job: drop it from the queue, or kill the worker running it.

        A cancelled job keeps its upload, so `retry` can run it again; the
        worker is told through the status, so a cancel that lands while the job
        is still waiting for the GPU lock is not lost.
        """
        with self._lock:
            job = self._jobs.get(identity or "")
            if job is None:
                return None
            if job.status in ("done", "error", "cancelled"):
                return self._view(job)
            # A stopped job is not a failed one: an old message would lie.
            job.status, job.error, job.progress = "cancelled", None, None
            self.archive.status(job.id, "cancelled")
            with self._current_lock:
                process = self._current if self._current_job is job else None
            if process is None:
                job.finished = time.time()
            self._persist()
        if process is not None and process.poll() is None:
            self._terminate(process)
        return self._view(job)

    def delete(self, identity: str | None) -> dict | None:
        """Forget a job and remove what it left: its transcript and its upload."""
        job = self.get(identity)
        if job is None:
            return None
        if job["status"] in ("waiting", "queued", "running"):
            self.cancel(identity)
        with self._lock:
            job = self._jobs.pop(identity or "", None)
            self._persist()
        if job is None:
            return None
        for path in list(job.tracks.values()) + list(self.out.glob(f"{job.id}.*")):
            try:
                path.unlink()
            except OSError:
                pass
        return self._view(job)

    def queued(self) -> int:
        return self._queue.qsize()

    def models(self, mistral_key: str = "", unsloth_key: str = "") -> list[dict]:
        """Batch transcription models: the configured one, plus the studio's
        and Mistral's diarizers when their keys are set."""
        if self.model and is_unsloth_asr(self.model):
            recipe = "unsloth"
        elif self.model and is_mistral_asr(self.model):
            recipe = "mistral"
        else:
            recipe = "local"
        items = [{"id": self.model, "recipe": recipe}] if self.model else []
        if unsloth_key:
            for name in UNSLOTH_BATCH_MODELS:
                if name != self.model:
                    items.append({"id": name, "recipe": "unsloth"})
        if mistral_key:
            for name in MISTRAL_BATCH_MODELS:
                if name != self.model:
                    items.append({"id": name, "recipe": "mistral"})
        return items

    def _work(self) -> None:
        while True:
            job = self._queue.get()
            # Cancelled while it waited: there is nothing left to run.
            if job.status != "cancelled":
                self._run(job)
            self._queue.task_done()

    def _run(self, job: Job) -> None:
        with self._current_lock:
            self._current_job = job
        job.status, job.started = "running", time.time()
        self.archive.status(job.id, "running")
        self._persist()
        try:
            self._transcribe(job)
        finally:
            job.finished = job.finished or time.time()
            # Archive before deleting: --no-keep-audio still leaves the WebDAV copy.
            self.archive.finish(job)
            # A failed WebDAV upload keeps the local file: deleting it would lose
            # the recording, and the row already says the copy is missing.
            if (not self.keep_audio and job.status == "done"
                    and self.archive.archived(job.id)):
                for track in job.tracks.values():
                    try:
                        track.unlink()
                    except OSError:
                        pass
            with self._current_lock:
                self._current_job = None
            self._persist()

    def _transcribe(self, job: Job) -> None:
        prefix = self.out / job.id
        audio = job.audio
        if audio is None:
            job.status = "error"
            job.error = "no audio for this job"
            job.finished = time.time()
            return
        if job.status == "cancelled":
            job.finished = time.time()
            return
        command = [str(self.meeting), str(audio), "--output", str(prefix),
                   "--asr", self.asr, "--model", self.model]
        if self.asr_dir:
            command += ["--asr-dir", self.asr_dir]
        if self.asr_remote_dir:
            command += ["--asr-remote-dir", self.asr_remote_dir]
        # A per-job option appended below wins: argparse keeps the last value.
        for key, flag in OPTION_FLAGS:
            if job.options.get(key) is not None:
                command += [flag, str(job.options[key])]
        try:
            process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                       text=True, start_new_session=True)
            with self._current_lock:
                self._current = process
            tail: list[str] = []

            def pump() -> None:
                # meeting-transcribe writes its progress to stderr; keep the last
                # line as the live status and the tail for an error message.
                for line in process.stderr:
                    line = line.rstrip()
                    if line:
                        tail.append(line)
                        del tail[:-40]
                        job.progress = line.strip()

            reader = threading.Thread(target=pump, daemon=True)
            reader.start()
            try:
                process.wait(timeout=self.timeout)
            except subprocess.TimeoutExpired:
                self._terminate(process)
                process.wait()
                raise
            finally:
                reader.join(timeout=5)
            if job.status == "cancelled":
                pass  # killed on purpose: keep it cancelled, not an error
            elif process.returncode != 0:
                job.status = "error"
                job.error = "\n".join(tail).strip()[-600:]
            else:
                job.json = json.loads(Path(f"{prefix}.json").read_text(encoding="utf-8"))
                job.markdown = Path(f"{prefix}.md").read_text(encoding="utf-8")
                job.status = "done"
        except subprocess.TimeoutExpired:
            job.status = "error"
            job.error = f"meeting-transcribe took more than {self.timeout:g}s"
        except (OSError, ValueError, json.JSONDecodeError) as error:
            job.status = "error"
            job.error = str(error)
        finally:
            with self._current_lock:
                self._current = None
            job.finished = time.time()
            # A failed job keeps its audio so it can be resubmitted (same bytes
            # mean the same id, and submit() requeues an errored job). The
            # archive and the --no-keep-audio deletion live in _run's finally:
            # they must see the status after every path, including a cancel.

    @staticmethod
    def _terminate(process: subprocess.Popen) -> None:
        """Stop the worker and any process it spawned."""
        try:
            os.killpg(os.getpgid(process.pid), signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            process.terminate()

    def stop(self) -> None:
        """Stop the running worker, if any, on service shutdown."""
        with self._current_lock:
            process = self._current
        if process is not None and process.poll() is None:
            self._terminate(process)

# --- live: audio in, source line and translation out -------------------------
# A browser streams 16 kHz mono PCM16; a pause in the speech ends an utterance,
# the utterance goes to the ASR endpoint as one clip, and the line comes back
# translated. Semi-batch on purpose: a whole utterance keeps the words Whisper
# needs, and the measured cost of one is a fraction of a second.
LIVE_RATE = 16000
LIVE_FRAME = 0.02                       # seconds of audio per energy frame
LIVE_BYTES_PER_S = LIVE_RATE * 2
LIVE_CUT = 0.6                          # a pause this long ends an ASR clip
LIVE_LINE = 1.5                         # a pause this long ends the line
# A new paragraph starts at a full stop, not at a breath: a pause closes the
# line only when the sentence is over, however long the pause was. Cutting
# mid-sentence is the one thing that must not happen — the translation of half a
# clause reads as a mistake, and a five-second silence in the middle of a
# sentence is still the middle of a sentence.
LIVE_SENTENCE_END = ".!?…"
LIVE_MIN_SPEECH = 0.6                   # a shorter cut is dropped, not transcribed
# The turn.end of a cloud ASR closes its line after this delay: the transcript
# trails the turn events by the streaming delay, so the last words come first.
LIVE_TURN_CLOSE_DELAY = 0.7
# No pause at all: cut here, at the quietest frame. Measured from the page with
# continuous speech, 20 s meant the first text appeared after ten seconds and
# then nothing until the next pause — "everyone keeps talking" is exactly the
# case that produced no text. A meeting pauses rarely, so this is the real
# granularity of the page, not LIVE_CUT.
LIVE_MAX = 4.0
LIVE_FLOOR = 200                        # RMS below this is silence in any room
TRANSLATE_PROMPT = (
    "You translate one line at a time from a live meeting into {target}. Keep the "
    "wording continuous with the context: it is the same conversation, line by line. "
    "Do not repeat the context, do not add quotes or notes, and translate the line you "
    "are given only. A line may be a fragment that ends mid-thought: translate the "
    "words you are given, do not complete the sentence yourself.")
LIVE_CONTEXT = 2                        # translated lines handed back as context
LIVE_TRANSLATE_EVERY = 60               # source characters between partial translations
# The first translation of a line is not worth waiting for: measured with a cloud
# model, the worker sat idle for 14.8 s while the page showed a source line with
# nothing under it, because the line had not reached 60 characters yet.
LIVE_TRANSLATE_FIRST = 20
LIVE_PENDING_CHARS = 140                # a longer line is split at a full stop
                                        # (two or three lines on the page)
SENTENCE_END = ".!?\u2026"
CLOSERS = "\"'\u00bb\u201c\u201d\u2019)]"  # may follow the full stop: "«…»"
LIVE_PENDING_HOLD = 10.0                # seconds a line may wait for a real pause
# The name, never the code: "translate into the language whose ISO 639-1 code is it"
# reads as the English pronoun and the model answers in English.
LANG_NAMES = {"it": "Italian", "en": "English", "de": "German", "fr": "French",
              "es": "Spanish", "pt": "Portuguese", "nl": "Dutch", "pl": "Polish",
              "ru": "Russian", "tr": "Turkish", "sv": "Swedish", "ja": "Japanese",
              "zh": "Chinese", "ar": "Arabic"}
ISO_LANGS = {name.lower(): code for code, name in LANG_NAMES.items()}
MISTRAL_HOST = "api.mistral.ai"
MISTRAL_URL = f"https://{MISTRAL_HOST}"
MISTRAL_BATCH_MODELS = ("voxtral-mini-transcribe-3", "voxtral-small-transcribe-3")
UNSLOTH_BATCH_MODELS = ("unsloth.MOSS-Transcribe-Diarize",)


def is_unsloth_asr(model: str) -> bool:
    """The id names its provider: unsloth.* is the studio's OpenAI audio endpoint."""
    return (model or "").startswith("unsloth.")
MISTRAL_LIVE_MODELS = ("voxtral-mini-transcribe-realtime-3", *MISTRAL_BATCH_MODELS)
AUDIOCPP_MODELS = {
    "vibevoice_asr_streaming_7b_q8_0": {
        "id": "vibevoice_asr_streaming_7b_q8_0",
        "family": "vibevoice_asr_streaming",
        "path": "/opt/audiocpp/models/VibeVoice-ASR-Streaming-7B-GGUF",
        "task": "asr",
        "mode": "streaming",
    },
    "moss-transcribe-diarize": {
        "id": "moss-transcribe-diarize",
        "family": "moss_transcribe_diarize",
        "path": "/opt/audiocpp/models/MOSS-Transcribe-Diarize-GGUF/moss-transcribe-diarize-bf16.gguf",
        "task": "asr",
        "mode": "offline",
    },
}


def ensure_audiocpp_model(base: str, model: str) -> None:
    """Load an audio.cpp model on demand if it was unloaded while idle."""
    spec = AUDIOCPP_MODELS.get(model)
    if not spec or not base:
        return
    request = urllib.request.Request(
        f"{base.rstrip('/')}/v1/models/load", data=json.dumps(spec).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=180):
            pass
    except (urllib.error.URLError, TimeoutError, OSError):
        pass


def iso_language(language: str | None) -> str:
    """Two-letter ISO 639-1 code for endpoints that reject 'auto' or full names."""
    raw = (language or "").strip().lower()
    if not raw or raw == "auto":
        return ""
    if len(raw) == 2 and raw.isalpha():
        return raw
    return ISO_LANGS.get(raw, "")


def unsloth_model_id(model: str) -> str:
    # The studio serves its models namespaced ("unsloth/Hy-MT2-7B-GGUF");
    # an id that carries its own namespace passes through untouched. A
    # "external::<connection>::<model>" id is a studio connection, already whole.
    rest = model.removeprefix("unsloth.")
    if rest.startswith("external::") or "/" in rest:
        return rest
    return f"unsloth/{rest}"


def is_mistral_asr(model: str) -> bool:
    """The model id names its provider: voxtral-* is Mistral's."""
    return (model or "").removeprefix("mistral.").startswith("voxtral-")


def is_mistral_realtime(model: str) -> bool:
    name = (model or "").removeprefix("mistral.")
    return name.startswith("voxtral-") and "realtime" in name
def translate_prompt(target: str) -> str:
    """The system prompt, with the language *name*: a bare code gets misread."""
    return TRANSLATE_PROMPT.format(target=LANG_NAMES.get(target.lower(), target or "English"))

def sentence_head(text: str, minimum: int) -> tuple[str, str]:
    """The first complete sentence past `minimum` characters, and what is left.

    Only an overflow valve: a line ends at a pause, not at a full stop, because
    the ASR puts one at the end of every clip. When a speaker runs on past
    `LIVE_PENDING_CHARS`, this cuts the line so one row does not become a wall of
    four sentences that take four seconds to translate.

    shortcut: "z. B." and "3.5" look like a sentence end; only the ASR's own
    punctuation is available, so a stray split is possible
    """
    for index, char in enumerate(text):
        if char in SENTENCE_END and index + 1 >= minimum:
            end = index + 1
            while end < len(text) and text[end] in SENTENCE_END + CLOSERS:
                end += 1
            return text[:end].strip(), text[end:].strip()
    return "", text

def frame_rms(pcm: bytes) -> list[int]:
    """The level of every 20 ms frame, so speech and room noise can be told apart."""
    step = int(LIVE_RATE * LIVE_FRAME) * 2
    return [int(math.sqrt(sum(sample * sample for sample in array.array("h", pcm[i:i + step]))
                          / (step // 2)))
            for i in range(0, len(pcm) - step + 1, step)]

def vad_cut(pcm: bytes, threshold: int,
            silence: float = LIVE_CUT) -> tuple[int, bool] | None:
    """Where the clip ends in `pcm`, or None while it is still going.

        Returns the cut and whether there was speech in it. The cut lands on the
    start of a pause, so a clip never opens mid-word. A clip boundary says
    nothing about the line: the line ends on a longer pause (a close marker
    queued by `feed`) or on a change of voice, never on the cut itself.
    """
    frames = frame_rms(pcm)
    if not frames:
        return None
    spoken = [value >= threshold for value in frames]
    step = int(LIVE_RATE * LIVE_FRAME) * 2
    # The first pause long enough to end an utterance, wherever it sits in the
    # buffer: waiting for the buffer to *end* in silence would glue the next
    # speaker's first words onto the previous line whenever they talk quickly.
    need = max(int(silence / LIVE_FRAME), 1)
    minimum = max(int(LIVE_MIN_SPEECH / LIVE_FRAME), 1)
    run = speech = 0
    for index, value in enumerate(spoken):
        if value:
            run = 0
            speech += 1
            continue
        run += 1
        if run >= need and speech >= minimum:
            return max(index + 1 - run, 1) * step, True
    if len(frames) * LIVE_FRAME < LIVE_MAX:
        return None
    # The quietest frame inside the allowed span, not inside the whole buffer:
    # the buffer is a chunk longer than LIVE_MAX, so the old last-40% could cut
    # at 5.4 s with LIVE_MAX at 4.
    span = min(int(LIVE_MAX / LIVE_FRAME), len(frames))
    quietest = int(span * 0.6)
    at = quietest + min(range(span - quietest), key=lambda i: frames[quietest + i])
    return max(at, 1) * step, any(spoken[:at])

def wav_bytes(pcm: bytes) -> bytes:
    buffer = io.BytesIO()
    with wave.open(buffer, "wb") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(LIVE_RATE)
        handle.writeframes(pcm)
    return buffer.getvalue()

def multipart(fields: dict | list[tuple[str, str]], filename: str, data: bytes) -> tuple[bytes, str]:
    """A multipart/form-data body with text fields and one file part."""
    boundary = "----halogen" + uuid.uuid4().hex
    body = bytearray()
    items = fields.items() if isinstance(fields, dict) else fields
    for name, value in items:
        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode()
    body += (f"--{boundary}\r\n"
             f"Content-Disposition: form-data; name=\"file\"; filename=\"{filename}\"\r\n"
             f"Content-Type: audio/wav\r\n\r\n").encode()
    body += data + f"\r\n--{boundary}--\r\n".encode()
    return bytes(body), boundary

# Queued after a clip when the pause outlasted LIVE_LINE: close the line now.
CLOSE = object()


class Partial:
    """Translate the row that is still open, and leave it open.

    Not a tuple: the queue already carries clips, and the tests queue those as
    (pcm, final) pairs.
    """

    __slots__ = ("row", "text")

    def __init__(self, row: int, text: str) -> None:
        self.row, self.text = row, text


class Close:
    """Translate this text into this row and finish it.

    The row is named rather than taken from the session, because a long line is
    split at a full stop: the head closes while the tail is already the line
    being built.
    """

    __slots__ = ("row", "text")

    def __init__(self, row: int, text: str) -> None:
        self.row, self.text = row, text


def sentence_split(text: str, minimum: int) -> tuple[str, str]:
    """The longest head that ends a sentence, and the rest.

    Empty head when there is no full stop to cut at: a long line is split where
    a sentence ends, never where it happens to be long.
    """
    for index in range(len(text) - 1, minimum - 1, -1):
        if text[index] in LIVE_SENTENCE_END:
            return text[:index + 1], text[index + 1:].strip()
    return "", text

# The models put their own bookkeeping in the words: MOSS answers
# "[0.00][S01] Hallo zusammen.[2.48]" and VibeVoice "\n Speaker 0:Hallo". On the
# live page those are not labels, they are noise in the middle of the sentence.
# Any bracketed tag: timestamps and speakers from MOSS, and VibeVoice's own
# "[Noise]", "[Laughter]", "[Unintelligible Speech]". Capped in length so a long
# bracketed sentence the speaker actually said is not swallowed.
LIVE_MARKER = re.compile(r"\[[^\]]{0,40}\]")
LIVE_SPEAKER_LABEL = re.compile(r"Speaker\s+\d+\s*:", re.IGNORECASE)

def repeated_tail(pending: str, addition: str, window: int = 240) -> str:
    """The part of `addition` that the line does not already say.

    The streaming model loops on long audio: a phrase it has just said arrives
    again, sometimes with something else in between, and appending it makes the
    line claim the speaker repeated themselves. Measured on both VibeVoice sizes.
    This only hides the symptom; the words after a loop are still the model's.
    """
    addition = addition.strip()
    if not addition or not pending:
        return addition
    tail = pending[-window:].lower()
    low = addition.lower()
    if low in tail:
        return ""
    # A delta that starts by repeating the end of the line: keep what is new.
    for size in range(min(len(low), 80), 3, -1):
        if tail.endswith(low[:size]):
            return addition[size:].strip()
    return addition


def clean_live_text(text: str) -> str:
    """The words alone, whatever markers the ASR wrapped them in."""
    return " ".join(LIVE_MARKER.sub(" ", LIVE_SPEAKER_LABEL.sub(" ", text)).split())

class StreamingASR:
    """One chunked POST held open for the whole session; deltas arrive as SSE.

    This is the only way to see words while someone is still speaking: the
    per-clip path sends nothing until a pause (or LIVE_MAX), so a line can only
    appear whole. Measured on the 7B, deltas land every ~3 s of speech.

    A raw socket, not http.client: that one refuses to read the response while
    the chunked body is still being written, which is exactly this request.
    """

    def __init__(self, base: str, model: str, on_text) -> None:
        parsed = urllib.parse.urlsplit(base)
        host = parsed.hostname or "127.0.0.1"
        port = parsed.port or 80
        path = (parsed.path or "").rstrip("/") + "/v1/audio/transcriptions/live?" + \
            urllib.parse.urlencode({"model": model})
        self.sock = socket.create_connection((host, port), timeout=900)
        self.sock.sendall(
            (f"POST {path} HTTP/1.1\r\nHost: {host}:{port}\r\n"
             "Content-Type: audio/pcm\r\nTransfer-Encoding: chunked\r\n"
             "Connection: close\r\n\r\n").encode())
        self.on_text = on_text
        self.dead = False
        self.reason = ""
        self._lock = threading.Lock()
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self) -> None:
        try:
            for raw in self.sock.makefile("rb"):
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data: "):
                    continue
                payload = line[6:]
                if payload == "[DONE]":
                    break
                try:
                    event = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                if event.get("type") == "transcript.text.delta":
                    self.on_text(str(event.get("delta") or ""))
                elif event.get("type") == "error":
                    # audio.cpp caps a live request (live_ingest.total_timeout_ms,
                    # 600 s by default) and says so in an event before closing.
                    detail = event.get("error") or event.get("message") or event
                    self.reason = f"the service ended the stream: {detail}"
        except (OSError, ValueError) as exc:
            self.reason = f"{type(exc).__name__}: {exc}"
        finally:
            self.reason = self.reason or "the service closed the stream"
            self.dead = True

    def feed(self, pcm: bytes) -> None:
        if self.dead:
            return
        with self._lock:
            try:
                self.sock.sendall(b"%x\r\n" % len(pcm) + pcm + b"\r\n")
            except OSError as exc:
                self.reason = f"send failed: {type(exc).__name__}: {exc}"
                self.dead = True

    def close(self) -> None:
        with self._lock:
            try:
                self.sock.sendall(b"0\r\n\r\n")
            except OSError:
                pass


class MistralRealtimeASR:
    """Mistral Voxtral Realtime WebSocket with end-of-turn detection.

    The protocol is four steps in order: connect, wait for `session.created`,
    send `session.update` (with `turn_detection` before any audio chunk, because
    settings lock on the first `input_audio.append` — turn detection and
    diarization cannot share a session), then stream base64 PCM16 chunks and
    read `transcription.segment` events carrying `text`. Diarization is off, so
    the segments carry no speaker_id: a turn, not a speaker change, is what
    ends a line — `on_turn` gets every `turn.end`. The transcript lags the turn
    events by the streaming delay, so the last words of a turn can still
    arrive after its turn.end.
    """

    def __init__(self, model: str, language: str, glossary: str, key: str,
                 on_text, host: str = MISTRAL_HOST, on_turn=None) -> None:
        if not key:
            raise ValueError("MISTRAL_API_KEY is not set")
        clean_model = model.removeprefix("mistral.")
        path = "/v1/audio/transcriptions/realtime?" + urllib.parse.urlencode({"model": clean_model})
        raw = socket.create_connection((host, 443), timeout=30)
        self.sock = ssl.create_default_context().wrap_socket(raw, server_hostname=host)
        ws_key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall(
            (f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
             f"Connection: Upgrade\r\nSec-WebSocket-Key: {ws_key}\r\n"
             f"Sec-WebSocket-Version: 13\r\nAuthorization: Bearer {key}\r\n"
             "User-Agent: meeting-stack/1.0\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                self.sock.close()
                raise OSError("Mistral WebSocket closed during handshake")
            buf += chunk
        header, self._rest = buf.split(b"\r\n\r\n", 1)
        status = header.splitlines()[0].decode("utf-8", "replace")
        if " 101 " not in status:
            detail = self._rest.decode("utf-8", "replace")[:200]
            self.sock.close()
            raise ValueError(f"Mistral Realtime refused ({status}): {detail}")
        self.on_text = on_text
        self.on_turn = on_turn        # a turn.end: what was said is a line
        self.dead = False
        self.reason = ""
        self._lock = threading.Lock()
        self._done = threading.Event()
        first = self._recv_frame()
        if not first or first.get("type") == "error":
            msg = (first or {}).get("error", {}).get("message") or "handshake failed"
            self.sock.close()
            raise ValueError(f"Mistral Realtime error: {msg}")
        session_cfg: dict = {
            "audio_format": {"encoding": "pcm_s16le", "sample_rate": LIVE_RATE},
            "target_streaming_delay_ms": 480,
            # End-of-turn detection, not diarization, ends a line (the two are
            # mutually exclusive in one session). Defaults: min 500 ms of pause
            # before a turn can end, 3 s at most.
            "turn_detection": {},
        }
        lang = iso_language(language)
        if lang:
            session_cfg["language"] = lang
        bias = [part.strip() for part in (glossary or "").split(",") if part.strip()]
        if bias:
            session_cfg["context_bias"] = bias
        self._send_json({"type": "session.update", "session": session_cfg})
        threading.Thread(target=self._read, daemon=True).start()

    def _send_json(self, obj: dict) -> None:
        data = json.dumps(obj).encode()
        mask = os.urandom(4)
        size = len(data)
        if size < 126:
            header = bytes([0x81, 0x80 | size]) + mask
        elif size < 65536:
            header = bytes([0x81, 0x80 | 126]) + struct.pack("!H", size) + mask
        else:
            header = bytes([0x81, 0x80 | 127]) + struct.pack("!Q", size) + mask
        masked = bytes(byte ^ mask[index & 3] for index, byte in enumerate(data))
        with self._lock:
            self.sock.sendall(header + masked)

    def _recv_frame(self) -> dict | None:
        def need(count: int) -> bool:
            while len(self._rest) < count:
                chunk = self.sock.recv(4096)
                if not chunk:
                    return False
                self._rest += chunk
            return True

        while True:
            if not need(2):
                return None
            b0, b1 = self._rest[0], self._rest[1]
            opcode, masked, length, idx = b0 & 0x0F, b1 & 0x80, b1 & 0x7F, 2
            if length == 126:
                if not need(4):
                    return None
                length, idx = struct.unpack("!H", self._rest[2:4])[0], 4
            elif length == 127:
                if not need(10):
                    return None
                length, idx = struct.unpack("!Q", self._rest[2:10])[0], 10
            if masked:
                if not need(idx + 4):
                    return None
                mask, idx = self._rest[idx:idx + 4], idx + 4
            if not need(idx + length):
                return None
            payload, self._rest = self._rest[idx:idx + length], self._rest[idx + length:]
            if masked:
                payload = bytes(byte ^ mask[index & 3] for index, byte in enumerate(payload))
            if opcode == 0x8:
                return None
            if opcode == 0x9:
                with self._lock:
                    self.sock.sendall(bytes([0x8A, 0x80]) + os.urandom(4))
                continue
            if opcode in (0x1, 0x2):
                return json.loads(payload.decode("utf-8", "replace"))

    def _read(self) -> None:
        try:
            while True:
                event = self._recv_frame()
                if event is None:
                    break
                kind = event.get("type")
                if kind == "transcription.segment":
                    self.on_text(str(event.get("text") or ""),
                                 str(event.get("speaker_id") or ""), False)
                elif kind == "transcription.text.delta":
                    self.on_text(str(event.get("text") or ""), "", False)
                elif kind == "turn.end" and self.on_turn:
                    self.on_turn()
                elif kind == "transcription.done":
                    break
                elif kind == "error":
                    err = event.get("error") or {}
                    detail = err.get("message") if isinstance(err, dict) else err
                    self.reason = f"Mistral Realtime error: {detail or event}"
                    break
        except (OSError, ValueError) as exc:
            self.reason = f"{type(exc).__name__}: {exc}"
        finally:
            self.reason = self.reason or "the service closed the stream"
            self.dead = True
            self._done.set()

    def feed(self, pcm: bytes) -> None:
        if self.dead:
            return
        try:
            self._send_json({"type": "input_audio.append",
                             "audio": base64.b64encode(pcm).decode()})
        except OSError as exc:
            self.reason = f"send failed: {type(exc).__name__}: {exc}"
            self.dead = True

    def close(self) -> None:
        if not self.dead:
            try:
                self._send_json({"type": "input_audio.end"})
                self._done.wait(timeout=3.0)
            except OSError:
                pass
        try:
            self.sock.close()
        except OSError:
            pass

class LiveSession:
    """One stream: audio chunks in, transcribed and translated rows out."""

    def __init__(self, live: "Live", language: str, target: str,
                 silence: float = LIVE_LINE, model: str = "",
                 asr_model: str = "", glossary: str = "") -> None:
        self.live = live
        self.language = language
        self.target = target
        # The page can pick the translator and transcriber per session; empty
        # means the service's default. Resolved once, so what the session
        # reports is what it uses.
        self.mt_model = model or getattr(live, "translate_model", "")
        self.asr_model = asr_model or getattr(live, "model", "")
        self.glossary = ", ".join(
            part.strip() for part in (getattr(live, "glossary", ""), glossary)
            if part and part.strip())
        self.silence = silence
        self.rows: list[dict] = []
        self.closed = False
        self.done = False                      # the worker drained the queue
        self.last = time.monotonic()
        self._pcm = b""
        self._noise = LIVE_FLOOR
        self._history: collections.deque = collections.deque(maxlen=int(30 / LIVE_FRAME))
        self._sources: collections.deque = collections.deque(maxlen=LIVE_CONTEXT)
        # The line being built: clips cut in the middle of a sentence keep landing
        # in the same row, so the page does not show one line per chunk and the
        # translator sees the whole sentence instead of half of it.
        self._pending = ""
        self._pending_row = 0
        self._pending_at = 0.0
        self._speaker = ""                       # speaker_id when the ASR sends one
        self._translated = 0                     # source length at the last partial translation
        self._partial_busy = False                # a partial translation is in flight
        # The newest text of the line being built, waiting for a free worker: a
        # queued translation of a line that has moved on is work nobody reads.
        self._dirty: tuple[int, str] | None = None
        # What the worker is doing right now, for the page: silence on screen
        # while a 10 s stretch waits for a pause reads as "the thing is broken".
        self._state = "idle"
        self._closing = False                    # a close is already queued
        self.stream: StreamingASR | MistralRealtimeASR | None = None
        self._stream_restarts = 0
        self._queue: queue.Queue = queue.Queue()
        self._lock = threading.RLock()
        threading.Thread(target=self._work, daemon=True).start()

    def _uses_stream(self) -> bool:
        if is_mistral_realtime(self.asr_model):
            return True
        if is_mistral_asr(self.asr_model):
            return False
        return bool(getattr(self.live, "stream_asr", False))

    def _open_stream(self) -> StreamingASR | MistralRealtimeASR:
        if is_mistral_realtime(self.asr_model):
            return MistralRealtimeASR(
                self.asr_model, self.language, self.glossary,
                getattr(self.live, "mistral_key", ""), self._streamed,
                on_turn=self._turn_end)
        return StreamingASR(self.live.asr, self.asr_model, self._streamed)

    def feed(self, pcm: bytes) -> None:
        with self._lock:
            if self.closed:
                return
            self.last = time.monotonic()
            self._pcm += pcm
            self._history.extend(frame_rms(pcm))
            if self._history:
                # The room's own level: a noisy room must not look like speech.
                floor = sorted(self._history)[len(self._history) // 5]
                self._noise = max(LIVE_FLOOR, int(floor * 2.5))
            if self._uses_stream():
                # Nothing is cut: the model segments as it listens, and its
                # deltas grow the row while the speaker is still talking. Only
                # the tail is kept, for the pause that ends the line.
                if self.stream is None or self.stream.dead:
                    if self.stream is not None:
                        # audio.cpp unloads a model it believes idle, or the
                        # socket drops: the call outlives any one stream, so
                        # open another instead of feeding a dead one until the
                        # meeting ends (that is the frozen panel).
                        self._stream_restarts += 1
                        print(f"live: the ASR stream ended ({self.stream.reason}); "
                              f"opening a new one ({self._stream_restarts})", flush=True)
                    if self._stream_restarts > 0:
                        ensure_audiocpp_model(self.live.asr, self.asr_model)
                    try:
                        self.stream = self._open_stream()
                    except (OSError, ValueError) as error:
                        self.rows.append({"src": "", "mt": "", "error": str(error)[:300],
                                          "done": True})
                        self.closed = True
                        self._queue.put(None)
                        return
                self.stream.feed(pcm)
                self._pcm = self._pcm[-int(self.silence * 4 * LIVE_BYTES_PER_S):]
                self._close_on_pause()
                return
            while True:
                cut = vad_cut(self._pcm, self._noise)
                if cut is None:
                    break               # and fall through to the silence check
                at, speech = cut
                clip, self._pcm = self._pcm[:at], self._pcm[at:]
                if speech and len(clip) >= LIVE_MIN_SPEECH * LIVE_BYTES_PER_S:
                    self._queue.put(clip)
            self._close_on_pause()

    def _turn_end(self) -> None:
        """A turn.end from the cloud ASR: this line is over; a new one starts
        with the next turn. The last words trail the event by the streaming
        delay (480 ms), so close on a timer, not on the spot.
        """
        with self._lock:
            row = self._pending_row
        timer = threading.Timer(LIVE_TURN_CLOSE_DELAY, self._close_turn, (row,))
        timer.daemon = True
        timer.start()

    def _close_turn(self, row: int) -> None:
        """Close `row`, unless something already did or the talk moved on."""
        with self._lock:
            if (self._closing or not self._pending or self._pending_row != row):
                return
            self._closing = True
            text = self._pending
            self._pending, self._translated, self._partial_busy = "", 0, False
        # shortcut: words of the next turn that land within the timer still join
        # the old row; rare (the turn must start within ~0.7 s) and cosmetic.
        self._queue.put(Close(row, text))

    def _close_on_pause(self) -> None:
        """End the line when the room has been quiet for LIVE_LINE.

        The clip may be queued but the line is not over: silence that keeps
        going past LIVE_LINE closes it, without waiting for the ASR. This is what
        lets clips stay short (0.45 s) while lines stay whole, and what lets a
        voice change be seen between two short clips.
        """
        if self._pending and not self._closing and len(self._pcm) >= 640:
            tail = self._pcm[-int(self.silence * 3 * LIVE_BYTES_PER_S):]
            quiet = 0
            for value in reversed(frame_rms(tail)):
                if value >= self._noise:
                    break
                quiet += 1
            if quiet * LIVE_FRAME < self.silence:
                return
            if not self._pending.rstrip().endswith(tuple(LIVE_SENTENCE_END)):
                return                      # the sentence is not over: same paragraph
            text, row = self._pending, self._pending_row
            self._pending = ""
            self._translated = 0
            self._partial_busy = False
            self._closing = True
            self._queue.put(Close(row, text))

    def close(self) -> None:
        with self._lock:
            if self.closed:
                return
            self.closed = True
            self.last = time.monotonic()
            stream, tail, self._pcm = self.stream, self._pcm, b""
        if stream is not None:
            stream.close()
        elif (len(tail) >= LIVE_MIN_SPEECH * LIVE_BYTES_PER_S
                and any(value >= self._noise for value in frame_rms(tail))):
            # Only if someone is still talking: Whisper invents words on silence.
            self._queue.put(tail)
        self._queue.put(None)

    def view(self, since: int) -> dict:
        with self._lock:
            # The cursor stops at the first row whose `done` is not set. Testing
            # `mt` instead is wrong: with streaming `mt` holds the first token
            # long before the line is finished, so the reader moved on and kept
            # the half sentence it had ("aveva affid").
            cursor = next((index for index, row in enumerate(self.rows)
                           if not row.get("done")), len(self.rows))
            return {"cursor": cursor, "open": not self.closed,
                    "rows": [{"i": index, **row}
                             for index, row in enumerate(self.rows) if index >= since],
                    "language": self.language, "to": self.target,
                    # Which translator and transcriber this session is actually
                    # using: the page choosing one and the server using another
                    # is invisible otherwise, and both answer "fine".
                    "mt_model": self.mt_model,
                    "asr_model": self.asr_model,
                    # seconds of audio held back waiting for a pause, and what
                    # the worker is up to: the page has nothing else to show
                    "buffered": round(len(self._pcm) / LIVE_BYTES_PER_S, 1),
                    "state": self._state,
                    # the worker has drained: no more rows can ever appear
                    "done": self.done}

    def _work(self) -> None:
        while True:
            item = self._queue.get()
            if item is CLOSE:
                self._flush()
                continue
            if item is None:
                self._flush()               # half a sentence still counts as words
                self.done = True
                return
            if isinstance(item, Close):
                with self._lock:
                    if self._dirty is not None and self._dirty[0] == item.row:
                        self._dirty = None
                self._translate_into(item.text, item.row, done=True)
                self._closing = False
                continue
            if isinstance(item, Partial):
                with self._lock:
                    row, text = self._dirty or (item.row, item.text)
                    self._dirty = None
                self._say_partial(text, row)
                with self._lock:
                    self._partial_busy = False
                continue
            clip = item
            self._set_state("asr")
            try:
                src = self.live.transcribe(clip, self.language, self.asr_model)
            except (OSError, ValueError) as error:
                # One failed clip must not end the session: say so and go on.
                with self._lock:
                    self.rows.append({"src": "", "mt": "", "error": str(error)[:300],
                                      "done": True})
                continue
            self._set_state("idle")
            if src:
                self._hear(src)

    def _streamed(self, delta: str, speaker: str = "", dedupe: bool = True) -> None:
        """A piece of the line, while the speaker is still talking.

        Voxtral Realtime emits LLM-style token pieces: a piece that starts with
        its own whitespace begins a word (' Abend'), one without continues the
        word in progress (' Hall' then 'o' = "Hallo") — gluing the pieces the
        way audio.cpp's whole segments want split every word that crossed one
        ("Fac ci amo", "gi usto"). audio.cpp never cuts inside a word, so it
        keeps the separator.
        """
        lead = delta[:1].isspace()
        text = clean_live_text(delta)
        if not text:
            return
        with self._lock:
            if self._pending and self._pending_row >= 0:
                fresh = repeated_tail(self._pending, text) if dedupe else text
                if not fresh:
                    return                  # the model said it again: not new words
                glue = "" if fresh[0] in ".!?,;:…)]\"'»" else (
                    " " if lead or not is_mistral_realtime(self.asr_model) else "")
                self._pending = f"{self._pending}{glue}{fresh}".strip()
                self.rows[self._pending_row]["src"] = self._pending
                if speaker and not self.rows[self._pending_row].get("speaker"):
                    self.rows[self._pending_row]["speaker"] = self._speaker = speaker
                # (The cloud ASR runs with turn detection, so its segments carry
                # no speaker_id; the label stays for whoever does send one.)
                if len(self._pending) >= LIVE_PENDING_CHARS:
                    head, tail = sentence_split(self._pending, LIVE_PENDING_CHARS // 2)
                    if head:
                        # Too long for the page: close the head where a sentence
                        # ends and keep the rest as the line being built.
                        row = self._pending_row
                        self.rows[row]["src"] = head
                        self._pending, self._translated = tail, len(tail)
                        self._partial_busy = False
                        if tail:
                            next_row: dict = {"src": tail, "mt": "", "done": False}
                            if self._speaker:
                                next_row["speaker"] = self._speaker
                            self.rows.append(next_row)
                            self._pending_row = len(self.rows) - 1
                        self._queue.put(Close(row, head))
                self._maybe_partial()
            else:
                new_row: dict = {"src": text, "mt": "", "done": False}
                if speaker:
                    new_row["speaker"] = speaker
                self.rows.append(new_row)
                self._pending, self._pending_row = text, len(self.rows) - 1
                self._speaker = speaker
                self._pending_at = time.monotonic()
                self._translated = 0
                self._maybe_partial()

    def _maybe_partial(self) -> None:
        """Translate the line so far, without waiting for it to end.

        Do not wait for the pause: translate what is there, and translate again
        when the line has grown some more. One at a time, or the queue fills
        with stale versions of a line nobody will read.
        """
        with self._lock:
            if self._partial_busy or self._pending_row < 0 or not self._pending:
                return
            threshold = (LIVE_TRANSLATE_EVERY if self.rows[self._pending_row]["mt"]
                         else LIVE_TRANSLATE_FIRST)
            if len(self._pending) - self._translated < threshold:
                return
            self._partial_busy = True
            self._translated = len(self._pending)
            self._dirty = (self._pending_row, self._pending)
        self._queue.put(Partial(self._pending_row, self._pending))

    def _set_state(self, state: str) -> None:
        with self._lock:
            self._state = state

    def _hear(self, src: str, closed: bool = False) -> None:
        """Add a clip's text to the line being built, and close it on a real pause.

        The ASR punctuates every clip as if it were a sentence, so its full stops
        mean nothing here: a clip ends where the speaker paused to breathe, and
        the line ends where the speaker paused for real (`LIVE_SILENCE`, 0.8 s).
        Merging on the pause is what stops "Bei der Bundeswehr gibt es mehr
        Gewalt." and "und Fehlverhalten als bislang bekannt." from being
        translated as two sentences.
        """
        with self._lock:
            if not self._pending:
                self.rows.append({"src": src, "mt": "", "done": False})
                self._pending, self._pending_row = src, len(self.rows) - 1
                self._pending_at = time.monotonic()
            else:
                self._pending = f"{self._pending} {src}".strip()
                self.rows[self._pending_row]["src"] = self._pending
            held = time.monotonic() - self._pending_at >= LIVE_PENDING_HOLD
            overlong = len(self._pending) >= LIVE_PENDING_CHARS
            if not closed and not held and not overlong:
                self._maybe_partial()
                return
            text, row = self._pending, self._pending_row
            self._pending = ""
            self._translated = 0
            self._partial_busy = False
            if overlong and not closed and not held:
                # Cut the line at a full stop and let the rest keep growing.
                head, tail = sentence_head(text, LIVE_PENDING_CHARS // 2)
                if head and tail:
                    self.rows[row]["src"] = head
                    self.rows.append({"src": tail, "mt": "", "done": False})
                    text, self._pending = head, tail
                    self._pending_row = len(self.rows) - 1
                    self._pending_at = time.monotonic()
        self._say(text, row)

    def _flush(self) -> None:
        with self._lock:
            if not self._pending:
                return
            text, row = self._pending, self._pending_row
            self._pending = ""
            self._closing = False
        self._say(text, row)

    def _say_partial(self, text: str, row: int) -> None:
        """Translate the line so far, and leave it open."""
        self._translate_into(text, row, done=False)

    def _say(self, text: str, row: int) -> None:
        """Translate the rest of the line into its row, and close it."""
        self._translate_into(text, row, done=True)

    def _translate_into(self, text: str, row: int, done: bool) -> None:
        """The whole line, every time — but never re-streamed.

        A fragment translated on its own loses the grammar of the sentence, so
        the source is always sent whole. What must not happen is the *display* of
        it: re-translating with the token callback rewrote the line from its
        first letter on every update, so words the speaker never changed appeared
        to be said again. Once a row has a translation, the new one is written in
        one go: identical words stay identical, and only what actually changed
        changes.
        """
        with self._lock:
            if row >= len(self.rows) or self.rows[row].get("done"):
                return
            previous = self.rows[row].get("mt", "")
            context = list(self._sources)

        def grew(partial: str) -> None:
            with self._lock:
                self.rows[row]["mt"] = partial

        self._set_state("mt")
        try:
            try:
                translated = self.live.translate(text, self.target, context,
                                                 None if previous else grew,
                                                 self.mt_model, self.glossary)
            except TypeError:
                translated = self.live.translate(text, self.target, context,
                                                 None if previous else grew,
                                                 self.mt_model)
            if not translated and context:
                # An empty answer is not an answer: try once without the context.
                try:
                    translated = self.live.translate(text, self.target, [], None,
                                                     self.mt_model, self.glossary)
                except TypeError:
                    translated = self.live.translate(text, self.target, [], None,
                                                     self.mt_model)
        except (OSError, ValueError) as error:
            with self._lock:
                self._state = "idle"
                if done:
                    self.rows[row]["error"] = str(error)[:300]
                    self.rows[row]["done"] = True
            return
        with self._lock:
            self.rows[row]["mt"] = translated
            self._state = "idle"
            if not done:
                return
            self.rows[row]["done"] = True
            if not translated:
                # Say it, instead of leaving the page on "…" for ever.
                self.rows[row]["error"] = "the model returned no translation"
            else:
                # Both sides of the line: the source alone tells the model what
                # was said, the pair tells it how we said it before.
                self._sources.append(f"{text} -> {translated}")

class Live:
    """The live sessions, and the GPU lock they share with the job queue."""

    def __init__(self, asr: str, model: str, llm: str, translate_model: str,
                 idle: float = 120, glossary: str = "",
                 silence: float = LIVE_LINE, live_asr: str = "",
                 live_model: str = "", stream_asr: bool = True,
                 mt_gateway: str = "", mistral_key: str = "",
                 unsloth_url: str = "", unsloth_key: str = "") -> None:
        # The live path can use its own endpoint: a clip every half second makes
        # the fixed cost of a request the whole budget, and the jobs keep their
        # own choice.
        self.asr = (live_asr or asr).rstrip("/")
        self.model = live_model or model
        # One long request per session instead of one per clip: the model's
        # deltas grow the line while the speaker is still talking.
        self.stream_asr = stream_asr
        self.mistral_key = mistral_key or os.environ.get("MISTRAL_API_KEY", "")
        # The studio's saved connections (the cloud keys live in it), once.
        self._provider_cache: list | None = None
        # Unsloth Studio serves its translators behind an OpenAI-compatible
        # API and a key: "unsloth.<model>" routes there (env, like Mistral).
        self.unsloth_url = (unsloth_url
                            or os.environ.get("UNSLOTH_URL", "")).rstrip("/")
        self.unsloth_key = unsloth_key or os.environ.get("UNSLOTH_API_KEY", "")
        self.llm = llm.rstrip("/")
        # The gateway that serves the cloud translators (Bifrost on :8080): its
        # opencode models are announced as "opencode.<id>" and routed back to it.
        self.gateway = mt_gateway.rstrip("/")
        self.translate_model = translate_model
        # Cloud models refuse a request that does not say which session it
        # belongs to ("cannot be routed efficiently"); one id per process is
        # enough, and a local backend ignores the header.
        self.session = uuid.uuid4().hex
        self.glossary = glossary
        self.idle = idle
        self.silence = silence
        self.sessions: dict[str, LiveSession] = {}
        self._lock = threading.Lock()
        threading.Thread(target=self._reap, daemon=True).start()

    def feed(self, identity: str, pcm: bytes, language: str, target: str,
             model: str = "", asr_model: str = "", glossary: str = "") -> LiveSession:
        """Add audio, opening the session on the first chunk."""
        with self._lock:
            session = self.sessions.get(identity)
            if session is None:
                session = self.sessions[identity] = LiveSession(
                    self, language, target, self.silence, model, asr_model, glossary)
        session.feed(pcm)
        return session

    def asr_models(self) -> list[dict]:
        """Live transcription models: the configured local one, plus Mistral if a key is set."""
        items = [{"id": self.model, "recipe": "local"}] if self.model else []
        if self.mistral_key:
            for name in MISTRAL_LIVE_MODELS:
                if name != self.model:
                    # No "diarize" flag: realtime runs with turn detection, so
                    # a line ends at a turn, and the rows carry no speaker.
                    items.append({"id": name, "recipe": "mistral"})
        return items

    def _providers(self) -> list[dict]:
        """The studio's saved connections, looked up once per process.

        The studio is the one gateway: its connections carry the cloud keys
        (the local Lemonade, Mistral, OpenCode Go), and every model addressed
        as "external::<connection id>::<model>" rides the studio's
        OpenAI-compatible endpoint - one URL and one key for all of them.
        """
        if self._provider_cache is None:
            try:
                request = urllib.request.Request(
                    f"{self.unsloth_url}/api/providers/",
                    headers={"Authorization": f"Bearer {self.unsloth_key}"})
                with urllib.request.urlopen(request, timeout=10) as response:
                    self._provider_cache = json.loads(response.read())
            except Exception:
                self._provider_cache = []
        return self._provider_cache

    def _provider_of(self, provider_type: str) -> dict | None:
        for row in self._providers():
            if row.get("provider_type") == provider_type:
                return row
        return None

    def _mistral_provider(self) -> dict | None:
        """The Mistral connection, whatever type the studio saved it as.

        The UI creates it as the built-in 'mistral' type or as a generic
        'custom' OpenAI-compatible endpoint - the base URL is the one thing
        that identifies it either way.
        """
        for row in self._providers():
            if "api.mistral.ai" in str(row.get("base_url") or ""):
                return row
        return self._provider_of("mistral")

    def models(self) -> list[dict]:
        """The translators this box actually has: Lemonade's, plus the cloud ones.

        Listed rather than hardcoded: a name in the page that the box does not
        serve is a setting that fails silently. Lemonade labels what a model can
        do, so "chat" is the filter — not the recipe, which is the runtime and
        would offer the rerankers too. On top of those, Mistral's
        chat models when a key is set and the gateway's opencode models when
        --mt-gateway is. A cloud id carries its provider as a prefix
        ("mistral.ministral-8b-latest", "opencode.opencode-go/model_1"), which is
        also how translate() routes it — away from --translate-url.
        """
        # The studio is the gateway for the local models too: what Lemonade
        # serves is one of its connections, so every id rides the studio
        # endpoint as external::<connection>::<model> - the chat label it
        # filters by still only Lemonade knows, so the CATALOG is read there.
        # Without a studio the bare ids stay, aimed straight at --translate-url.
        connection = (self._provider_of("llama_cpp")
                      if self.unsloth_url and self.unsloth_key else None)
        items: list[dict] = []
        try:
            with urllib.request.urlopen(f"{self.llm}/api/v1/models", timeout=10) as response:
                answer = json.loads(response.read())
            found = answer.get("data") or answer.get("models") or []
            for model in found:
                if not (isinstance(model, dict) and "chat" in (model.get("labels") or [])):
                    continue
                if connection is not None:
                    items.append({"id": (f"unsloth.external::{connection['id']}::"
                                         f"{model.get('id')}"), "recipe": "unsloth"})
                else:
                    items.append({"id": model.get("id"), "recipe": model.get("recipe")})
        except Exception:
            pass
        return (items + self._mistral_translators() + self._unsloth_translators()
                + self._opencode_translators())

    def _unsloth_translators(self) -> list[dict]:
        """The studio's translation models as "unsloth.<id>", when its key is set.

        Fetched, not hardcoded: only what the studio actually serves appears in
        the page. The family carries MT in its name (Hy-MT2-7B-GGUF today).
        """
        if not self.unsloth_key or not self.unsloth_url:
            return []
        try:
            request = urllib.request.Request(
                f"{self.unsloth_url}/v1/models",
                headers={"Authorization": f"Bearer {self.unsloth_key}"})
            with urllib.request.urlopen(request, timeout=10) as response:
                answer = json.loads(response.read())
            return [{"id": f"unsloth.{model.get('id', '').rsplit('/', 1)[-1]}",
                     "recipe": "unsloth"}
                    for model in answer.get("data") or []
                    if "MT" in str(model.get("id") or "")]
        except Exception:
            return []

    def _mistral_translators(self) -> list[dict]:
        """Mistral's chat models as "mistral.<id>".

        The studio's Mistral connection lists them when its key is set; the
        direct API still answers without one, but only what the picker shows.
        """
        connection = (self._mistral_provider()
                      if self.unsloth_url and self.unsloth_key else None)
        if connection is not None:
            # The saved catalog can hold ids a wrong fetch brought in (zai-,
            # deepseek-): only the Mistral families are announced, and voxtral
            # stays out - it is the transcriber, already in asr_models.
            return [{"id": f"mistral.{name}", "recipe": "mistral"}
                    for name in connection.get("models") or []
                    if name.startswith(("mistral-", "ministral-", "magistral-"))]
        if not self.mistral_key:
            return []
        try:
            request = urllib.request.Request(
                f"{MISTRAL_URL}/v1/models",
                headers={"Authorization": f"Bearer {self.mistral_key}",
                         "User-Agent": "meeting-stack/1.0"})
            with urllib.request.urlopen(request, timeout=10) as response:
                found = json.loads(response.read()).get("data") or []
        except Exception:
            return []
        return [{"id": f"mistral.{model.get('id')}", "recipe": "mistral"}
                for model in found
                if isinstance(model, dict)
                and (model.get("capabilities") or {}).get("completion_chat")
                and not model.get("deprecation")
                # voxtral is the transcriber, already announced in asr_models
                and not str(model.get("id") or "").startswith("voxtral-")]

    def _opencode_translators(self) -> list[dict]:
        """The OpenCode models as "opencode.<id>".

        The studio's connection lists them when its key is set; --mt-gateway
        answers without one, but only what the picker shows.
        """
        connection = (self._provider_of("opencode_go")
                      if self.unsloth_url and self.unsloth_key else None)
        if connection is not None:
            return [{"id": f"opencode.{name}", "recipe": "opencode"}
                    for name in connection.get("models") or []]
        if not self.gateway:
            return []
        try:
            with urllib.request.urlopen(f"{self.gateway}/v1/models", timeout=10) as response:
                found = json.loads(response.read()).get("data") or []
        except Exception:
            return []
        return [{"id": f"opencode.{model.get('id')}", "recipe": "opencode"}
                for model in found
                if isinstance(model, dict) and model.get("owned_by") == "opencode"]

    def get(self, identity: str) -> LiveSession | None:
        with self._lock:
            found = self.sessions.get(identity)
            return found

    def close(self, identity: str) -> LiveSession | None:
        session = self.get(identity)
        if session is not None:
            session.close()
        return session

    def transcribe(self, pcm: bytes, language: str, model: str = "") -> str:
        chosen = model or self.model
        if is_mistral_asr(chosen):
            if not self.mistral_key:
                raise ValueError("MISTRAL_API_KEY is not set")
            clean = chosen.removeprefix("mistral.")
            fields: dict[str, str] = {"model": clean}
            lang = iso_language(language)
            if lang:
                fields["language"] = lang
            body, boundary = multipart(fields, "clip.wav", wav_bytes(pcm))
            request = urllib.request.Request(
                f"{MISTRAL_URL}/v1/audio/transcriptions", data=body,
                headers={"Authorization": f"Bearer {self.mistral_key}",
                         "Content-Type": f"multipart/form-data; boundary={boundary}",
                         "User-Agent": "meeting-stack/1.0"})
            with urllib.request.urlopen(request, timeout=60) as response:
                return clean_live_text(str(json.loads(response.read()).get("text", "")))
        fields = {"model": chosen, "response_format": "json", "max_tokens": "512"}
        if language:
            fields["language"] = language
        body, boundary = multipart(fields, "clip.wav", wav_bytes(pcm))
        request = urllib.request.Request(
            self.asr + "/v1/audio/transcriptions", data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
        with urllib.request.urlopen(request, timeout=60) as response:
            return clean_live_text(str(json.loads(response.read()).get("text", "")))

    def translate(self, src: str, target: str, context: list[str],
                  on_token=None, model: str = "", glossary: str = "") -> str:
        """The line in the target language; `on_token` gets every partial text.

        Streaming is what makes the page feel live: the generation is 0.4-0.5 s
        for a short line, and showing it grow beats waiting for the whole thing.
        `model` is the session's choice; empty means --translate-model.
        """
        model = model or self.translate_model
        if not src or not model:
            return ""
        content = "".join(f"Context line: {line}\n" for line in context)
        content += f"\nTranslate this line:\n{src}"
        system = translate_prompt(target)
        terms = glossary or self.glossary
        if terms:
            system += f" Keep these spellings unchanged: {terms}."
        payload = {
            "model": model,
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": content}],
            # top_p rides along because a gateway in the middle can inject its
            # own default, and Mistral refuses top_p != 1 with temperature 0.
            "max_tokens": 1200, "temperature": 0, "top_p": 1,
            "stream": on_token is not None}
        if not model.startswith("mistral."):
            # A thinking model spends the budget on its reasoning first, and a
            # cloud one then answers with a null message — which Lemonade turns
            # into a 500. Mistral's API rejects both fields with 400/422.
            payload["reasoning_effort"] = "none"
            payload["chat_template_kwargs"] = {"enable_thinking": False}
        try:
            return self._ask(payload, on_token)
        except urllib.error.HTTPError as error:
            if error.code in (400, 422) and "reasoning_effort" in payload:
                payload.pop("reasoning_effort", None)
                payload.pop("chat_template_kwargs", None)
                return self._ask(payload, on_token)
            # A model registered by hand is served as "user.<id>", while Lemonade
            # lists it without the prefix: asking for the listed name is a 404
            # from the backend, and that 404 is the only place the difference
            # shows. Nothing was streamed yet, so trying again is safe. Only for
            # the local endpoint — a provider-prefixed model is routed elsewhere.
            if error.code != 404 or model.startswith(("user.", "builtin.",
                                                     "mistral.", "opencode.",
                                                     "unsloth.")):
                raise
            payload["model"] = f"user.{model}"
            return self._ask(payload, on_token)

    def _ask(self, payload: dict, on_token=None) -> str:
        # A provider-prefixed model does not go to --translate-url: "mistral."
        # is api.mistral.ai itself (the key rides in the Authorization header),
        # "opencode." is the model at --mt-gateway with the prefix stripped.
        model = str(payload.get("model") or "")
        headers = {"Content-Type": "application/json",
                   "x-opencode-session": self.session}
        # The studio is the gateway: a cloud model rides its saved connection
        # (external::<id>::<model>) when there is one; the direct paths stay
        # only for a deployment that has no studio at all.
        external = ""
        if self.unsloth_url and self.unsloth_key:
            if model.startswith("mistral."):
                connection = self._mistral_provider()
                if connection is not None:
                    external = (f"external::{connection['id']}::"
                                + urllib.parse.quote(model.removeprefix("mistral.")))
            elif model.startswith("opencode."):
                connection = self._provider_of("opencode_go")
                if connection is not None:
                    external = (f"external::{connection['id']}::"
                                + urllib.parse.quote(model.removeprefix("opencode.")))
        if external:
            url = f"{self.unsloth_url}/v1/chat/completions"
            headers["Authorization"] = f"Bearer {self.unsloth_key}"
            payload = dict(payload, model=external)
        elif model.startswith("mistral."):
            if not self.mistral_key:
                raise ValueError("MISTRAL_API_KEY is not set")
            url = f"{MISTRAL_URL}/v1/chat/completions"
            headers["Authorization"] = f"Bearer {self.mistral_key}"
            payload = dict(payload, model=model.removeprefix("mistral."))
        elif model.startswith("unsloth."):
            if not self.unsloth_key:
                raise ValueError("UNSLOTH_API_KEY is not set")
            if not self.unsloth_url:
                raise ValueError("no UNSLOTH_URL configured for unsloth.* models")
            url = f"{self.unsloth_url}/v1/chat/completions"
            headers["Authorization"] = f"Bearer {self.unsloth_key}"
            payload = dict(payload, model=unsloth_model_id(model))
        elif model.startswith("opencode."):
            if not self.gateway:
                raise ValueError("no --mt-gateway configured for opencode.* models")
            url = f"{self.gateway}/v1/chat/completions"
            payload = dict(payload, model=model.removeprefix("opencode."))
        else:
            url = self.llm + "/v1/chat/completions"
        request = urllib.request.Request(url, data=json.dumps(payload).encode(),
                                         headers=headers)
        with urllib.request.urlopen(request, timeout=60) as response:
            if on_token is None:
                answer = json.loads(response.read())
                return str(answer["choices"][0]["message"].get("content") or "").strip().strip('"')
            text = ""
            for line in response:
                line = line.strip()
                if not line.startswith(b"data: "):
                    continue
                line = line[len(b"data: "):]
                if line.startswith(b"[DONE]"):
                    break
                try:
                    chunk = json.loads(line)
                except ValueError:
                    continue
                if chunk.get("error"):
                    # A backend refusal arrives inside a 200 stream, so nothing
                    # raised it and the caller could not retry the name.
                    raise urllib.error.HTTPError(
                        url, int(chunk["error"].get("status_code") or 404),
                        str(chunk["error"].get("message") or "the backend refused"), None, None)
                try:
                    piece = chunk["choices"][0]["delta"].get("content") or ""
                except (KeyError, IndexError, TypeError):
                    continue
                if piece:
                    text += piece
                    on_token(text)
        return text.strip().strip('"')

    def _reap(self) -> None:
        while True:
            time.sleep(5)
            now = time.monotonic()
            with self._lock:
                for identity, session in list(self.sessions.items()):
                    if not session.closed and now - session.last > self.idle:
                        session.close()
                    elif session.done and now - session.last > self.idle:
                        # Readable for a while after the end so the last row can
                        # still be collected; then forgotten.
                        del self.sessions[identity]

class ToolError(Exception):
    pass

def tools() -> list[dict]:
    return [
        {"name": "transcribe_meeting",
         "description": "Queue a meeting recording for diarized transcription. Use POST /jobs "
                        "instead for large files. Returns a job id and its status.",
         "inputSchema": {"type": "object", "properties": {
             "audio_base64": {"type": "string", "description": "the recording, base64-encoded"},
             "filename": {"type": "string", "description": "original name: format hint, archive name and /hook join key"},
             "language": {"type": "string", "description": "force a language, e.g. de or German"},
             "hotwords": {"type": "string", "description": "names and jargon to bias the ASR"},
             "names": {"type": "string", "description": "speaker names, e.g. 1:Anna,2:Bernd"}},
             "required": ["audio_base64"]}},
        {"name": "meeting_status",
         "description": "Status of a transcription job by id.",
         "inputSchema": {"type": "object", "properties": {"id": {"type": "string"}},
                         "required": ["id"]}},
        {"name": "meeting_result",
         "description": "The transcript of a finished job, as markdown (default) or json.",
         "inputSchema": {"type": "object", "properties": {
             "id": {"type": "string"},
             "format": {"type": "string", "enum": ["markdown", "json"]}},
             "required": ["id"]}},
    ]

def call_tool(jobs: Jobs, name: str, arguments: dict) -> str:
    if name == "transcribe_meeting":
        if "model" in arguments:
            raise ToolError(MODEL_FIXED)
        encoded = arguments.get("audio_base64")
        if not isinstance(encoded, str) or not encoded:
            raise ToolError("audio_base64 is required")
        try:
            audio = base64.b64decode(encoded, validate=True)
        except (binascii.Error, ValueError) as error:
            raise ToolError(f"audio_base64 is not valid base64: {error}")
        options = {key: arguments[key] for key, _ in OPTION_FLAGS if arguments.get(key) is not None}
        return json.dumps(jobs.submit(audio, options, arguments.get("filename")))
    if name in ("meeting_status", "meeting_result"):
        job = jobs.get(arguments.get("id"))
        if job is None:
            raise ToolError(f"no job with id {arguments.get('id')!r}")
        if name == "meeting_status":
            return json.dumps({"id": job["id"], "status": job["status"], "error": job["error"]})
        if job["status"] != "done":
            return f"job {job['id']} is {job['status']}" + (f": {job['error']}" if job["error"] else "")
        return json.dumps(job["json"]) if arguments.get("format") == "json" else job["markdown"]
    raise ToolError(f"unknown tool {name!r}")

def mcp_response(jobs: Jobs, message: dict) -> dict | None:
    """JSON-RPC reply for one message; None for a notification."""
    method = message.get("method")
    identity = message.get("id")
    if method == "initialize":
        requested = (message.get("params") or {}).get("protocolVersion")
        version = requested if requested in PROTOCOL_SUPPORTED else PROTOCOL_LATEST
        result = {"protocolVersion": version, "capabilities": {"tools": {"listChanged": False}},
                  "serverInfo": {"name": "halogen-meeting", "version": "1.0.0"}}
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": tools()}
    elif method == "tools/call":
        params = message.get("params") or {}
        try:
            text = call_tool(jobs, params.get("name"), params.get("arguments") or {})
            result = {"content": [{"type": "text", "text": text}]}
        except ToolError as error:
            result = {"content": [{"type": "text", "text": str(error)}], "isError": True}
    elif method in ("notifications/initialized", "notifications/cancelled", "notifications/progress"):
        return None
    else:
        return {"jsonrpc": "2.0", "id": identity,
                "error": {"code": -32601, "message": f"method not found: {method}"}}
    if identity is None:
        return None
    return {"jsonrpc": "2.0", "id": identity, "result": result}

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server: "Server"

    def log_message(self, *args) -> None:
        pass

    def _authorized(self) -> bool:
        token = self.server.token
        if not token:
            return True
        if self.headers.get("Authorization") == f"Bearer {token}":
            return True
        # <audio src> cannot send headers: the playback route takes the token in
        # the query string instead, and only that route accepts it there.
        path = urllib.parse.urlparse(self.path)
        if path.path.startswith("/jobs/") and path.path.endswith("/audio"):
            return urllib.parse.parse_qs(path.query).get("token", [""])[0] == token
        if path.path.startswith("/live/"):
            # The live page speaks fetch() and sets the header; the query token is
            # for curl and for a browser tab opened straight on an audio URL.
            return urllib.parse.parse_qs(path.query).get("token", [""])[0] == token
        return False

    def _json(self, status: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _text(self, status: int, text: str) -> None:
        body = text.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _html(self, status: int, text: str) -> None:
        body = text.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> bytes | None:
        length = int(self.headers.get("Content-Length") or 0)
        if length > self.server.max_upload:
            self._json(413, {"error": f"upload over {self.server.max_upload} bytes"})
            return None
        return self.rfile.read(length) if length else b""

    def do_GET(self) -> None:
        path = urllib.parse.urlparse(self.path).path
        if path in ("/", "/ui"):
            try:
                page = (HERE / "dashboard.html").read_text(encoding="utf-8")
            except OSError:
                self._text(500, "dashboard.html is missing next to meeting-job\n")
                return
            self._html(200, page)
            return
        if path == "/live":
            # One bundle, two views: the page picks its view from the path.
            try:
                page = (HERE / "dashboard.html").read_text(encoding="utf-8")
            except OSError:
                self._text(500, "dashboard.html is missing next to meeting-job\n")
                return
            self._html(200, page)
            return
        if path == "/health":
            self._json(200, {"status": "ok", "jobs": len(self.server.jobs.list()),
                             "queue": self.server.jobs.queued(),
                             "archive": self.server.jobs.archive.webdav is not None})
            return
        if not self._authorized():
            self._json(401, {"error": "missing or wrong bearer token"})
            return
        if path == "/files":
            self._json(200, {"files": self.server.jobs.archive.rows()})
        elif path == "/archive":
            self._json(200, self.server.jobs.archive.check())
        elif path == "/hooks":
            self._json(200, {"hooks": hook_view(self.server.hooks, self.server.jobs)})
        elif path.startswith("/hooks/"):
            views = hook_view(self.server.hooks, self.server.jobs,
                              path.removeprefix("/hooks/"))
            if not views:
                self._json(404, {"error": "no such hook"})
            else:
                self._json(200, views[0])
        elif path == "/jobs":
            self._json(200, {"jobs": [self._summary(job) for job in self.server.jobs.list()]})
        elif path.startswith("/jobs/") and path.endswith("/audio"):
            self._send_audio(path[len("/jobs/"):-len("/audio")])
        elif path.startswith("/jobs/"):
            job = self.server.jobs.get(path.removeprefix("/jobs/"))
            if job is None:
                self._json(404, {"error": "no such job"})
            else:
                self._json(200, job)
        elif path == "/mcp":
            self._text(405, "the MCP endpoint accepts POST\n")
        elif path == "/live/models":
            key = getattr(self.server.live, "mistral_key", "")
            asr_models = (self.server.live.asr_models()
                          if hasattr(self.server.live, "asr_models") else [])
            batch_models = (self.server.jobs.models(
                                key, os.environ.get("UNSLOTH_API_KEY", ""))
                            if hasattr(self.server.jobs, "models") else [])
            self._json(200, {"models": self.server.live.models(),
                             "default": self.server.live.translate_model,
                             "asr_models": asr_models,
                             "asr_default": getattr(self.server.live, "model", ""),
                             "batch_models": batch_models,
                             "batch_default": getattr(self.server.jobs, "model", "")})
        elif path.startswith("/live/"):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            try:
                since = int(query.get("since", ["0"])[0])
            except ValueError:
                since = 0
            session = self.server.live.get(path.removeprefix("/live/"))
            if session is None:
                self._json(404, {"error": "no such live session"})
            else:
                self._json(200, session.view(since))
        else:
            self._json(404, {"error": "not found"})

    def _send_audio(self, identity: str) -> None:
        """The uploaded recording, seekable: players ask for byte ranges."""
        audio = self.server.jobs.audio_path(identity)
        if audio is None:
            self._json(404, {"error": "no audio kept for this job"})
            return
        size = audio.stat().st_size
        span = byte_range(self.headers.get("Range"), size)
        start, end = span or (0, size - 1)
        self.send_response(206 if span else 200)
        self.send_header("Content-Type",
                         mimetypes.guess_type(audio.name)[0] or "application/octet-stream")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        if span:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        try:
            with audio.open("rb") as handle:
                handle.seek(start)
                left = end - start + 1
                while left > 0:
                    chunk = handle.read(min(262144, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass  # the player seeked elsewhere; the response is already abandoned

    def do_POST(self) -> None:
        if not self._authorized():
            self._json(401, {"error": "missing or wrong bearer token"})
            return
        body = self._body()
        if body is None:
            return
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/jobs":
            if not body:
                self._json(400, {"error": "empty body: send the audio as the request body"})
                return
            query = urllib.parse.parse_qs(parsed.query)
            if "model" in query:
                self._json(400, {"error": MODEL_FIXED})
                return
            options = {}
            for key, value in query.items():
                if key == "filename":
                    continue
                try:
                    options[key] = int(value[0]) if key in INT_OPTIONS else float(value[0])
                except ValueError:
                    options[key] = value[0]
            job = self.server.jobs.submit(body, options, query.get("filename", [None])[0])
            self._json(202, self._summary(job))
        elif parsed.path == "/hook":
            # The recorder calls this once per recording, after the mixed file
            # is on WebDAV. Idempotent on purpose: a retry or a startup sweep sends
            # the same body again, and that must stay a 200.
            try:
                payload = json.loads(body or b"{}")
            except json.JSONDecodeError as error:
                self._json(400, {"error": f"invalid JSON: {error}"})
                return
            entry, error = self.server.hooks.announce(payload)
            if error:
                self._json(400, {"error": error})
                return
            view = hook_view(self.server.hooks, self.server.jobs, entry["pair"])[0]
            self._json(200, {"ok": True, **view})
        elif parsed.path.startswith("/jobs/") and parsed.path.endswith("/retry"):
            job = self.server.jobs.retry(parsed.path[len("/jobs/"):-len("/retry")])
            if job is None:
                self._json(404, {"error": "no such job"})
            else:
                self._json(202, self._summary(job))
        elif parsed.path.startswith("/jobs/") and parsed.path.endswith("/stop"):
            job = self.server.jobs.cancel(parsed.path[len("/jobs/"):-len("/stop")])
            if job is None:
                self._json(404, {"error": "no such job"})
            else:
                self._json(200, self._summary(job))
        elif parsed.path == "/mcp":
            try:
                message = json.loads(body or b"null")
            except json.JSONDecodeError as error:
                self._json(400, {"jsonrpc": "2.0", "id": None,
                                 "error": {"code": -32700, "message": f"parse error: {error}"}})
                return
            reply = mcp_response(self.server.jobs, message)
            if reply is None:
                self.send_response(202)
                self.send_header("Content-Length", "0")
                self.end_headers()
            else:
                self._json(200, reply)
        elif parsed.path.startswith("/live/") and parsed.path.endswith(("/audio", "/close")):
            identity, _, action = parsed.path[len("/live/"):].rpartition("/")
            if action == "close":
                session = self.server.live.close(identity)
                if session is None:
                    self._json(404, {"error": "no such live session"})
                else:
                    self._json(200, {"ok": True, "cursor": session.view(0)["cursor"]})
                return
            if not body:
                self._json(400, {"error": "empty body: send PCM16 mono 16 kHz"})
                return
            query = urllib.parse.parse_qs(parsed.query)
            asr_choice = query.get("asr_model", [""])[0]
            glossary = query.get("glossary", [""])[0]
            session = self.server.live.feed(identity, body, query.get("language", [""])[0],
                                            query.get("to", [""])[0],
                                            query.get("mt_model", [""])[0],
                                            asr_choice, glossary)
            view = session.view(0)
            self._json(202, {"ok": True, "cursor": view["cursor"],
                             "open": view["open"]})
        else:
            self._json(404, {"error": "not found"})

    def do_DELETE(self) -> None:
        if not self._authorized():
            self._json(401, {"error": "missing or wrong bearer token"})
            return
        path = urllib.parse.urlparse(self.path).path
        if not path.startswith("/jobs/"):
            self._json(404, {"error": "no such route"})
            return
        job = self.server.jobs.delete(path.removeprefix("/jobs/"))
        if job is None:
            self._json(404, {"error": "no such job"})
        else:
            self._json(200, self._summary(job))

    @staticmethod
    def _summary(job: dict) -> dict:
        return {key: job.get(key) for key in ("id", "status", "error", "created",
                                              "started", "finished", "options", "progress",
                                              "tracks", "duration", "audio", "archive",
                                              "filename")}

class Server(ThreadingHTTPServer):
    def __init__(self, address, jobs: Jobs, hooks: Hooks, token: str,
                 max_upload: int, live: Live) -> None:
        self.jobs = jobs
        self.hooks = hooks
        self.token = token
        self.max_upload = max_upload
        self.live = live
        super().__init__(address, Handler)

def main() -> None:
    parser = argparse.ArgumentParser(description="Async transcription jobs with a REST and MCP endpoint.")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8099)
    parser.add_argument("--dir", type=Path, default=Path("/mnt/fanxiang/cache/mcp-meeting-transcribe"),
                        help="root for inbox/ and out/ "
                             "(default /mnt/fanxiang/cache/mcp-meeting-transcribe)")
    parser.add_argument("--meeting", type=Path, default=HERE / "meeting-transcribe",
                        help="the worker script (default meeting-transcribe next to this one)")
    parser.add_argument("--asr", default="http://ubuntu:8090",
                        help="audio.cpp base URL for the live transcriber and the direct "
                             "batch fallback (default http://ubuntu:8090)")
    parser.add_argument("--model", default="moss-transcribe-diarize",
                        help="ASR model the endpoint serves "
                             "(default moss-transcribe-diarize)")
    parser.add_argument("--asr-dir", default=None,
                        help="directory the ASR server can read, where "
                             "the normalized WAV is written (audio.cpp takes a path, not an upload)")
    parser.add_argument("--asr-remote-dir", default=None,
                        help="how --asr-dir is seen by the ASR server (default: the same path)")
    parser.add_argument("--token", default=os.environ.get("MEETING_TOKEN", ""),
                        help="bearer token required on every route but /health (default $MEETING_TOKEN)")
    parser.add_argument("--max-upload", type=int, default=512 * 1024 * 1024,
                        help="largest audio upload in bytes (default 512 MiB)")
    parser.add_argument("--job-timeout", type=float, default=14400,
                        help="seconds one transcription may take (default 14400)")
    parser.add_argument("--no-keep-audio", action="store_false", dest="keep_audio",
                        help="delete the uploaded audio after the job instead of keeping it "
                             "for the dashboard's player (kept by default, pruned after "
                             "--retain-audio-days)")
    parser.add_argument("--retain-audio-days", type=float, default=30,
                        help="delete kept uploads older than this many days; 0 keeps them "
                             "forever (default 30)")
    parser.add_argument("--live-asr", default="",
                        help="audio.cpp base URL for the live path only (default: --asr)")
    parser.add_argument("--live-model", default="",
                        help="ASR model for the live path only (default: --model)")
    parser.add_argument("--translate-url", default="http://127.0.0.1:8731",
                        help="OpenAI-compatible chat endpoint for live translation "
                             "(default Lemonade on 127.0.0.1:8731)")
    parser.add_argument("--translate-model", default="",
                        help="chat model that translates the live lines, e.g. "
                             "Qwen3.8-27B-GGUF; empty serves the live transcript untranslated")
    parser.add_argument("--mt-gateway", default="",
                        help="OpenAI-compatible gateway for the cloud translators (Bifrost on "
                             "http://127.0.0.1:8080): its opencode models are listed in "
                             "/live/models as opencode.<id>, and mt_model=opencode.<id> is "
                             "routed there with the prefix stripped (empty disables them)")
    parser.add_argument("--live-idle", type=float, default=120,
                        help="seconds a live session may go without audio before it closes "
                             "(default 120)")
    parser.add_argument("--live-silence", type=float, default=LIVE_LINE,
                        help="a pause this long ends a live line (default "
                             f"{LIVE_LINE:g}); a line also needs to end on a full stop, "
                             "unless the silence runs three times longer")
    parser.add_argument("--no-live-stream", action="store_false", dest="live_stream",
                        help="send one clip per utterance instead of audio.cpp's streaming "
                             "endpoint (/v1/audio/transcriptions/live): the text arrives "
                             "only on a pause (streaming is the default)")
    parser.add_argument("--live-glossary", default="",
                        help="names and terms the live translation must leave unchanged, "
                             "comma separated (default: none)")
    parser.add_argument("--archive-db", type=Path,
                        default=(Path(os.environ["ARCHIVE_DB"])
                                 if os.environ.get("ARCHIVE_DB") else None),
                        help="SQLite ledger of received files and their WebDAV copies "
                             "(default $ARCHIVE_DB or <dir>/archive.db)")
    parser.add_argument("--webdav-url", default=os.environ.get("WEBDAV_URL", ""),
                        help="WebDAV collection to archive uploads into; empty records them "
                             "in the ledger without copying (default $WEBDAV_URL)")
    parser.add_argument("--webdav-user", default=os.environ.get("WEBDAV_USER", ""),
                        help="WebDAV user (default $WEBDAV_USER)")
    parser.add_argument("--webdav-password", default=os.environ.get("WEBDAV_PASSWORD", ""),
                        help="WebDAV password (default $WEBDAV_PASSWORD)")
    parser.add_argument("--webdav-dir", default=os.environ.get("WEBDAV_DIR", "meeting-stack"),
                        help="folder under the WebDAV root (default meeting-stack)")
    args = parser.parse_args()

    webdav = (WebDAV(args.webdav_url, args.webdav_user, args.webdav_password,
                     args.webdav_dir)
              if args.webdav_url else None)
    jobs = Jobs(args.meeting, args.dir.expanduser(), args.keep_audio, args.job_timeout,
                args.asr, args.model,
                args.asr_dir, args.asr_remote_dir,
                retain_days=args.retain_audio_days,
                archive_db=args.archive_db.expanduser() if args.archive_db else None,
                webdav=webdav)
    hooks = Hooks(args.dir.expanduser() / "hooks.json")
    live = Live(args.asr, args.model, args.translate_url, args.translate_model,
                args.live_idle, args.live_glossary, args.live_silence,
                args.live_asr, args.live_model,
                args.live_stream, mt_gateway=args.mt_gateway)
    server = Server((args.host, args.port), jobs, hooks, args.token, args.max_upload, live)
    auth = "bearer token required" if args.token else "NO AUTH: anyone who can reach the port can use it"
    translate = args.translate_model or "no translation (--translate-model is empty)"
    print(f"live: line closes at {args.live_silence:g}s of pause"
          f", asr {live.asr} ({live.model})"
          f"{' streaming' if live.stream_asr else ' per clip'}", flush=True)
    print(f"meeting-job on http://{args.host}:{args.port}  ({auth})", flush=True)
    print(f"live translation: {translate}", flush=True)
    print(f"archive: {'WebDAV ' + args.webdav_url if webdav else 'ledger only (set WEBDAV_URL)'}",
          flush=True)

    def shutdown(signum, frame) -> None:
        jobs.stop()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    server.serve_forever()

if __name__ == "__main__":
    main()
