# Diarized meeting transcription: REST jobs + MCP + dashboard, in one container.
#
# User unit (rootless podman box). Install:
#   podman build -t localhost/meeting-job ~/Github/meeting-stack
#   install -m 644 systemd/meeting-job.service ~/.config/systemd/user/
#   install -d -m 700 ~/.config/meeting-stack
#   printf 'MEETING_TOKEN=%s\n' "$(openssl rand -hex 24)" > ~/.config/meeting-stack/meeting-job.env
#   chmod 600 ~/.config/meeting-stack/meeting-job.env
#   systemctl --user enable --now podman.socket      # the container starts the diarizers through it
#   systemctl --user daemon-reload
#   systemctl --user enable --now meeting-job.service
#   loginctl enable-linger "$USER"      # start at boot, without a login
#
# The service runs in a container; the diarizer containers are started by the
# host's podman through its socket, so they still get the GPU devices and the
# images already on the host. Paths passed to `podman run` are host paths: the
# cache dirs below are mounted at the same absolute path inside the container.
# The service only starts jobs; each job needs the ASR endpoint up and the
# diarizer image built. Defaults (2026-10-27): Qwen3-ASR-1.7B through gufo on
# 8097 (host network), one request per diarizer turn (--asr-mode segments; gufo's
# verbose_json has no usable segments), and the Nemotron diarizer
# (diarizer-nemotron/). --keep-audio keeps the upload so the dashboard can play
# the recording next to the transcript; the files live in
# ~/.cache/mcp-meeting-transcribe/inbox/ and are pruned after
# --retain-audio-days (default 30; 0 keeps them). Send language=de:
# with language=auto Qwen3-ASR answers short turns in a foreign language (25 of
# 226 turns of a German meeting came back in Chinese). Switch back to the
# one-pass Whisper path with --asr http://127.0.0.1:8731 --model
# Whisper-Large-v3-Turbo --asr-mode full (Lemonade, do not unload its model).
# --live-embedder ends a line when the voice changes, not only at a pause
# (the sherpa image carries the 28 MB 3D-Speaker embedding).
# --translate-model turns on live translation at GET /live (one line at a time,
# semi-batch); it loads that model into Lemonade's llm slot and keeps it there.
# An empty --translate-model serves the live transcript alone.
[Unit]
Description=Diarized meeting transcription (REST + MCP + dashboard, container)
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Service]
Type=simple
EnvironmentFile=-%h/.config/meeting-stack/meeting-job.env
ExecStart=/usr/bin/podman run --rm --replace --name meeting-job --network=host \
  --security-opt no-new-privileges \
  -v %h/.cache/mcp-meeting-transcribe:%h/.cache/mcp-meeting-transcribe:rw \
  -v %h/.cache/huggingface:%h/.cache/huggingface:rw \
  -v /run/user/%U:/run/user/%U \
  -e HOME=%h \
  -e CONTAINER_HOST=unix:///run/user/%U/podman/podman.sock \
  -e MEETING_TOKEN \
  localhost/meeting-job:latest \
  --dir %h/.cache/mcp-meeting-transcribe --port 8099 \
  --asr http://127.0.0.1:8097 --model qwen3-asr-1.7b \
  --diarizer nemotron --asr-mode segments \
  --keep-audio \
  --translate-url http://127.0.0.1:8731 --translate-model Qwen3.8-27B-GGUF \
  --live-embedder localhost/halogen-diarizer
# --live-asr http://127.0.0.1:8731 --live-model Whisper-Large-v3-Turbo  is one
# flag away, but on this box it puts a second model on the iGPU next to the 27B
# that does the translating: measured 20 t/s with it resident against 35.7 t/s
# earlier without it (cause not isolated: that whisper-server belongs to a
# root-run Lemonade service and ignores both the unload API and kill as my user).
# gufo is already resident and costs 0.78 s per clip instead of 0.24 s.
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=default.target
