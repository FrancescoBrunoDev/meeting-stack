# Diarized meeting transcription: REST jobs + MCP + dashboard, in one container.
#
# User unit (rootless podman box). Install:
#   podman build -t localhost/meeting-job ~/Github/meeting-stack
#   install -m 644 systemd/meeting-job.service ~/.config/systemd/user/
#   install -d -m 700 ~/.config/meeting-stack
#   printf 'MEETING_TOKEN=%s\nMISTRAL_API_KEY=%s\n' "$(openssl rand -hex 24)" "$KEY" \
#     > ~/.config/meeting-stack/meeting-job.env
#   chmod 600 ~/.config/meeting-stack/meeting-job.env
#   systemctl --user daemon-reload
#   systemctl --user enable --now meeting-job.service
#   loginctl enable-linger "$USER"      # start at boot, without a login
#
# A plain podman service: no podman socket, no device mounts, no nesting —
# the container only serves HTTP and shells out to ffmpeg. All inference is
# somebody else's: the batch ASR is MOSS-Transcribe-Diarize through audio.cpp
# on http://ubuntu:8090 (one request for the whole meeting; it answers the
# speaker labels and the timestamps itself; `--asr-dir` is the share audio.cpp
# reads the normalized WAV from, ~/audio mounted at the same path it has on
# the ASR host), or Mistral with asr_mode=mistral when $MISTRAL_API_KEY is set.
# Live transcription is audio.cpp's streaming endpoint; translation is
# Lemonade on :8731, Mistral or the Bifrost gateway on :8080 (--mt-gateway).
# --keep-audio keeps the upload so the dashboard can play the recording next
# to the transcript; the files live in ~/.cache/mcp-meeting-transcribe/inbox/
# and are pruned after --retain-audio-days (default 30; 0 keeps them). Send
# language=de: with language=auto Qwen3-ASR answers short turns in a foreign
# language (25 of 226 turns of a German meeting came back in Chinese).
[Unit]
Description=Diarized meeting transcription (REST + MCP + dashboard, container)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/meeting-stack/meeting-job.env
EnvironmentFile=-%h/.config/meeting-job.env
ExecStart=/usr/bin/podman run --rm --replace --name meeting-job --network=host \
  --security-opt no-new-privileges \
  -v %h/.cache/mcp-meeting-transcribe:%h/.cache/mcp-meeting-transcribe:rw \
  -v %h/audio:/asr-share:rw \
  -e HOME=%h \
  -e MEETING_TOKEN \
  -e MISTRAL_API_KEY \
  localhost/meeting-job:latest \
  --dir %h/.cache/mcp-meeting-transcribe --port 8099 \
  --asr http://ubuntu:8090 --model moss-transcribe-diarize \
  --asr-mode audiocpp --asr-dir /asr-share --asr-remote-dir /opt/audiocpp \
  --keep-audio \
  --translate-url http://127.0.0.1:8731 --translate-model Qwen3.8-27B-GGUF \
  --live-asr http://ubuntu:8090 --live-model vibevoice_asr_streaming_7b_q8_0 \
  --mt-gateway http://127.0.0.1:8080 \
  --live-stream
# audio.cpp reads only 16 kHz mono WAV, so meeting-transcribe normalizes with
# ffmpeg. Measured on a 38-minute German meeting: 429 turns in 25 minutes of
# wall time, prompt 30365 tokens. The max_tokens cap must be generous and must
# travel under "options" — at 24000 the model ends in "reached max_tokens before
# EOS" and the transcript is lost, not truncated; at 65536 (what the UI used) it
# finishes. That cap is memory: the decode cache is prompt + max_tokens.
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=default.target
